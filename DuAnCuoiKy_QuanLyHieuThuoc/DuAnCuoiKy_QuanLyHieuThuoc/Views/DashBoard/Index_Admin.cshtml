@using DuAnCuoiKy_QuanLyHieuThuoc.Helpers
@model DuAnCuoiKy_QuanLyHieuThuoc.Models.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Dashboard Quản lý";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="p-4">
    <div class="mb-4">
        <h3 class="fw-bold text-dark">Chào mừng trở lại, @User.Identity.Name!</h3>
        <p class="text-muted small">Hệ thống ghi nhận @Model.SoHoaDonHomNay hóa đơn trong ngày hôm nay.</p>
    </div>

    <!-- Hàng 1: Thẻ thống kê (Dữ liệu SQL thật) -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="stat-card shadow-sm">
                <div class="stat-label text-muted small fw-bold">DOANH THU HÔM NAY</div>
                <div class="h3 fw-bold text-primary">@CurrencyHelper.ToVnd(Model.DoanhThuHomNay)</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card shadow-sm">
                <div class="stat-label text-muted small fw-bold">SỐ HÓA ĐƠN</div>
                <div class="h3 fw-bold">@Model.SoHoaDonHomNay</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card shadow-sm border-start border-4 border-warning">
                <div class="stat-label text-muted small fw-bold">THUỐC SẮP HẾT</div>
                <div class="h3 fw-bold text-warning">@Model.ThuocSapHetHang</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card shadow-sm border-start border-4 border-danger">
                <div class="stat-label text-muted small fw-bold">LÔ SẮP HẾT HẠN</div>
                <div class="h3 fw-bold text-danger">@Model.LoSapHetHan</div>
            </div>
        </div>
    </div>

    <!-- Hàng 2: Biểu đồ & Cảnh báo -->
    <div class="row g-4 mb-4">
        <div class="col-md-8">
            <div class="content-card shadow-sm">
                <h5 class="fw-bold mb-4">Doanh thu 6 tháng (Triệu đồng)</h5>
                <div style="position: relative; height: 320px;">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="content-card shadow-sm">
                <h5 class="fw-bold mb-4 text-danger">Cần nhập hàng gấp</h5>
                <div class="list-group list-group-flush">
                    @foreach (var item in Model.DanhSachCanhBao)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center border-0 px-0 py-2 border-bottom">
                            <span class="small fw-bold">@item.TenSp</span>
                            <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill">Tồn: @item.SoLuongTon</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Hàng 3: Hóa đơn mới nhất -->
    <div class="content-card shadow-sm">
        <h5 class="fw-bold mb-4">Hóa đơn mới phát sinh</h5>
        <table class="table align-middle table-hover">
            <thead class="table-light">
                <tr>
                    <th>MÃ HĐ</th>
                    <th>THỜI GIAN</th>
                    <th>THU NGÂN</th>
                    <th class="text-end">TỔNG TIỀN</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var hd in Model.HoaDonMoiNhat)
                {
                    <tr>
                        <td class="fw-bold text-primary">@hd.MaHd</td>
                        <td class="small">@hd.NgayBan.ToString("HH:mm - dd/MM")</td>
                        <td>@hd.TenNhanVien</td>
                        <td class="text-end fw-bold">@CurrencyHelper.ToVnd(hd.TongTien)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // TRUYỀN DỮ LIỆU TỪ C# SANG JS
        const labels = @Html.Raw(Json.Serialize(Model.LabelsBieuDo));
        const dataValues = @Html.Raw(Json.Serialize(Model.DataBieuDo));

        const ctx = document.getElementById('revenueChart').getContext('2d');
        new Chart(ctx, {
        type: 'bar',
        data: {
        labels: labels,
        datasets: [{
        label: 'Doanh thu',
        data: dataValues,
        backgroundColor: '#0d6efd',
        borderRadius: 8
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } }
        }
        });
    </script>
}