@using DuAnCuoiKy_QuanLyHieuThuoc.Helpers
@model DuAnCuoiKy_QuanLyHieuThuoc.Models.ViewModels.ReportViewModel

@{
    ViewData["Title"] = "Báo cáo & Phân tích";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/baocao.css" asp-append-version="true" />
}

<div class="p-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold">Tổng quan kinh doanh</h3>
        <button class="btn btn-primary px-4 rounded-3 fw-bold shadow-sm"><i class="bi bi-download me-2"></i>Xuất báo cáo</button>
    </div>

    <!-- Hàng 1: Thẻ tài chính -->
    <div class="row g-3 mb-4">
        @{
            var stats = new[] {
                new { Lbl = "DOANH THU", Val = ReportHelper.FormatShort(Model.DoanhThuThang), Icon = "cash-stack", Color = "primary" },
                new { Lbl = "HÓA ĐƠN", Val = Model.SoHoaDon.ToString("N0"), Icon = "receipt", Color = "secondary" },
                new { Lbl = "NHẬP KHO", Val = ReportHelper.FormatShort(Model.GiaTriNhapKho), Icon = "box-seam", Color = "danger" },
                new { Lbl = "LỢI NHUẬN", Val = ReportHelper.FormatShort(Model.LoiNhuan), Icon = "piggy-bank", Color = "success" }
            };
        }
        @foreach (var s in stats)
        {
            <div class="col-md-3">
                <div class="report-stats-card shadow-sm">
                    <div class="text-muted small fw-bold mb-2">@s.Lbl</div>
                    <div class="h3 fw-bold text-dark">@s.Val<span>đ</span></div>
                    <div class="text-success small fw-bold"><i class="bi bi-graph-up"></i> +8.2% <span class="text-muted fw-normal">tháng này</span></div>
                </div>
            </div>
        }
    </div>

    <!-- Hàng 2: Biểu đồ -->
    <div class="row g-4 mb-4">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm p-4 rounded-4">
                <h5 class="fw-bold mb-4">Doanh thu 12 tháng gần nhất</h5>
                <div style="height: 350px; position: relative;">
                    <canvas id="revenue12MonthsChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 rounded-4 text-center">
                <h5 class="fw-bold mb-4 text-start">Cơ cấu loại thuốc</h5>
                <div style="height: 250px; position: relative;" class="mb-4">
                    <canvas id="categoryDonutChart"></canvas>
                    <div class="chart-center-text">
                        <div class="h4 fw-bold mb-0">100%</div>
                        <div class="text-muted small">Phân bổ</div>
                    </div>
                </div>
                @foreach (var c in Model.CoCauThuoc)
                {
                    <div class="d-flex justify-content-between small border-bottom py-2">
                        <span><i class="bi bi-circle-fill me-2" style="color: @c.Mau"></i> @c.Ten</span>
                        <span class="fw-bold">@c.PhanTram%</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- AI Insights (Sử dụng Model SQL) -->
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card ai-card-insight p-4 shadow-sm h-100">
                <h6 class="fw-bold text-primary"><i class="bi bi-lightbulb me-2"></i>GỢI Ý NHẬP HÀNG (AI)</h6>
                <p class="small text-muted mt-3">Dựa trên tốc độ bán hàng, hệ thống gợi ý bạn nên bổ sung <strong>Khẩu trang y tế</strong> vì nhu cầu đang tăng cao.</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card ai-card-monitor p-4 shadow-sm h-100">
                <h6 class="fw-bold text-danger"><i class="bi bi-exclamation-triangle me-2"></i>CẢNH BÁO HẠN DÙNG</h6>
                <p class="small text-muted mt-3">Phát hiện <strong>@Model.SoLoSapHetHan lô thuốc</strong> sắp hết hạn trong 30 ngày tới. Vui lòng kiểm tra mục Xử lý cận hạn.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Dữ liệu từ SQL truyền vào JS
        const labels12T = @Html.Raw(Json.Serialize(Model.Labels12Thang));
        const data12T = @Html.Raw(Json.Serialize(Model.DataDoanhThu));

        // Vẽ biểu đồ Doanh thu (Vẫn dùng JS cũ nhưng data động)
        const ctxBar = document.getElementById('revenue12MonthsChart');
        new Chart(ctxBar, { type: 'bar', data: { labels: labels12T, datasets: [{ data: data12T, backgroundColor: '#0d6efd', borderRadius: 5 }] }, options: { responsive: true, maintainAspectRatio: false } });
    </script>
    <script src="~/js/baocao.js" asp-append-version="true"></script>
}