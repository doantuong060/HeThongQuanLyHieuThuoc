@model DuAnCuoiKy_QuanLyHieuThuoc.Models.ViewModels.StaffIndexViewModel
@{
    ViewData["Title"] = "Quản trị nhân sự";
    Layout = "_Layout";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@section Styles {
    <link rel="stylesheet" href="~/css/nhanvien.css" asp-append-version="true" />
}

<div class="p-4">
    <!-- Header -->
    <div class="mb-4">
        <h3 class="fw-bold">Nhân viên</h3>
        <p class="text-muted small">Quản lý danh sách và cấp quyền truy cập hệ thống.</p>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="staff-stat-card shadow-sm">
                <div class="text-muted small fw-bold">TỔNG NHÂN SỰ</div>
                <div class="h2 fw-bold">@Model.TongNhanSu</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="staff-stat-card shadow-sm border-start border-4 border-success">
                <div class="text-muted small fw-bold text-success">ĐANG LÀM VIỆC</div>
                <div class="h2 fw-bold">@Model.DangLamViec</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="staff-stat-card shadow-sm border-start border-4 border-primary">
                <div class="text-muted small fw-bold text-primary">DƯỢC SĨ CHÍNH</div>
                <div class="h2 fw-bold">@Model.DuocSiChinh</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="staff-stat-card shadow-sm border-start border-4 border-warning">
                <div class="text-muted small fw-bold text-warning">TẠM NGHỈ</div>
                <div class="h2 fw-bold">@Model.TamNghi</div>
            </div>
        </div>
    </div>

    <!-- Toolbar -->
    <div class="card border-0 shadow-sm p-3 mb-4 rounded-4">
        <div class="row g-3 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light border-0 px-3"><i class="bi bi-search"></i></span>
                    <input type="text" id="staffSearch" value="@ViewBag.CurrentSearch"
                           class="form-control bg-light border-0" placeholder="Tìm tên, mã hoặc SĐT...">
                </div>
            </div>
            <div class="col-md-8 text-end">
                <button type="button" class="btn btn-primary px-4 rounded-3 fw-bold"
                        data-bs-toggle="modal" data-bs-target="#modalThemNV">
                    <i class="bi bi-plus-lg me-2"></i>Thêm nhân viên
                </button>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0 table-hover table-staff">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">MÃ NV</th>
                        <th>HỌ TÊN</th>
                        <th>SĐT / EMAIL</th>
                        <th>VAI TRÒ</th>
                        <th>NGÀY VÀO</th>
                        <th>TRẠNG THÁI</th>
                        <th class="text-end pe-4">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var nv in Model.DanhSachNhanVien)
                    {
                        <tr class="staff-row"
                            style="cursor:pointer;"
                            data-manv="@nv.MaNv"
                            data-hoten="@nv.HoTen"
                            data-gioitinh="@nv.GioiTinh"
                            data-sdt="@nv.SoDienThoai"
                            data-email="@(nv.Email ?? "")"
                            data-ngayvaolam="@nv.NgayVaoLam.ToString("dd/MM/yyyy")"
                            data-trangthai="@(nv.TrangThai ? "Đang làm" : "Nghỉ việc")"
                            data-trangthai-bool="@nv.TrangThai.ToString().ToLower()"
                            data-vaitro="@(nv.TaiKhoan?.MaVaiTroNavigation?.TenVaiTro ?? "")">
                            <td class="ps-4 fw-bold text-primary small">@nv.MaNv</td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="avatar-initial">@nv.HoTen.Substring(0, 1).ToUpper()</div>
                                    <div class="fw-bold">@nv.HoTen</div>
                                </div>
                            </td>
                            <td>
                                <div class="small">@nv.SoDienThoai</div>
                                <div class="text-muted small" style="font-size: 11px;">@nv.Email</div>
                            </td>
                            <td>
                                @if (nv.TaiKhoan?.MaVaiTroNavigation != null)
                                {
                                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3">
                                        @nv.TaiKhoan.MaVaiTroNavigation.TenVaiTro
                                    </span>
                                }
                            </td>
                            <td class="small text-muted">@nv.NgayVaoLam.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="badge @(nv.TrangThai ? "bg-success" : "bg-danger") bg-opacity-10 text-@(nv.TrangThai ? "success" : "danger") rounded-pill px-3">
                                    @(nv.TrangThai ? "Đang làm" : "Nghỉ việc")
                                </span>
                            </td>

                            <td class="text-end pe-4">
                                <!-- Nút chỉnh sửa thông tin nhân viên -->
                                <button type="button"
                                        class="btn btn-sm btn-light rounded-circle me-1 btn-sua-nv"
                                        data-manv="@nv.MaNv"
                                        title="Chỉnh sửa nhân viên">
                                    <i class="bi bi-pencil"></i>
                                </button>

                                <!-- Nút khóa / mở khóa -->
                                <form asp-action="ToggleStatus" asp-controller="NhanViens"
                                      method="post" style="display:inline;"
                                      class="form-toggle-status">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@nv.MaNv" />
                                    <button type="submit"
                                            class="btn btn-sm btn-light rounded-circle text-@(nv.TrangThai ? "danger" : "success") btn-toggle-status"
                                            data-hoten="@nv.HoTen"
                                            data-trangthai="@nv.TrangThai.ToString().ToLower()"
                                            title="@(nv.TrangThai ? "Khóa tài khoản" : "Mở khóa tài khoản")">
                                        <i class="bi bi-@(nv.TrangThai ? "lock" : "unlock")"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Chi tiết Nhân viên -->
<div class="modal fade" id="modalChiTietNV" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header border-0 p-4 pb-0">
                <h5 class="fw-bold mb-0">Chi tiết nhân viên</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="avatar-initial" id="detail-avatar"
                         style="width:56px;height:56px;font-size:22px;flex-shrink:0;"></div>
                    <div>
                        <div class="fw-bold fs-5" id="detail-hoten"></div>
                        <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 mt-1"
                              id="detail-vaitro"></span>
                    </div>
                </div>
                <table class="table table-borderless small mb-0">
                    <tr>
                        <td class="text-muted fw-bold ps-0" style="width:42%">
                            <i class="bi bi-person-badge me-2"></i>Mã nhân viên
                        </td>
                        <td class="fw-bold text-primary" id="detail-manv"></td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-bold ps-0">
                            <i class="bi bi-gender-ambiguous me-2"></i>Giới tính
                        </td>
                        <td id="detail-gioitinh"></td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-bold ps-0">
                            <i class="bi bi-telephone me-2"></i>Số điện thoại
                        </td>
                        <td id="detail-sdt"></td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-bold ps-0">
                            <i class="bi bi-envelope me-2"></i>Email
                        </td>
                        <td id="detail-email"></td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-bold ps-0">
                            <i class="bi bi-calendar-check me-2"></i>Ngày vào làm
                        </td>
                        <td id="detail-ngayvaolam"></td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-bold ps-0">
                            <i class="bi bi-circle-fill me-2"></i>Trạng thái
                        </td>
                        <td id="detail-trangthai"></td>
                    </tr>
                </table>
            </div>
            <div class="modal-footer border-0 p-4 pt-0">
                <button type="button" class="btn btn-light px-4 rounded-3 fw-bold"
                        data-bs-dismiss="modal">
                    Đóng
                </button>
            </div>
        </div>
    </div>
</div>

<partial name="_ModalThemNhanVien" />

@section Scripts {
    <script src="~/js/nhanvien.js" asp-append-version="true"></script>
}
