@model DuAnCuoiKy_QuanLyHieuThuoc.Models.ViewModels.PhieuNhapCreateViewModel

@{
    ViewData["Title"] = "Tạo phiếu nhập";
    Layout = "_Layout";
}

<div class="container-fluid py-4 px-4 bg-light min-vh-100">

    <div class="mb-4">
        <div class="text-muted small mb-1">
            Quản lý kho / Nhập kho Dược phẩm
        </div>

        <h2 class="fw-bold mb-0">
            Tạo phiếu nhập hàng
        </h2>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <strong>Vui lòng kiểm tra lại thông tin:</strong>

            <ul class="mb-0 mt-2">
                @foreach (var err in ViewData.ModelState.Values.SelectMany(x => x.Errors))
                {
                    <li>@err.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form asp-action="Create" method="post">

        <div class="row">

            <!-- BÊN TRÁI -->
            <div class="col-lg-8">

                <!-- THÔNG TIN PHIẾU -->
                <div class="card shadow-sm border-0 mb-4">

                    <div class="card-body">

                        <h5 class="fw-bold mb-4">
                            Thông tin chứng từ
                        </h5>

                        <div class="row">

                            <div class="col-md-4">

                                <label class="form-label">
                                    Nhà cung cấp
                                </label>

                                <select asp-for="MaNcc"
                                        asp-items="Model.DsNhaCungCap"
                                        class="form-select">

                                    <option value="">
                                        -- Chọn nhà cung cấp --
                                    </option>

                                </select>

                            </div>

                            <div class="col-md-4">

                                <label class="form-label">
                                    Ngày nhập kho
                                </label>

                                <input type="date"
                                       class="form-control"
                                       value="@DateTime.Now.ToString("yyyy-MM-dd")"
                                       readonly />

                            </div>

                            <div class="col-md-4">

                                <label class="form-label">
                                    Nhân viên kho
                                </label>

                                <input type="text"
                                       class="form-control"
                                       value="Nhân viên kho"
                                       readonly />

                            </div>

                        </div>

                    </div>

                </div>

                <!-- CHI TIẾT -->
                <div class="card shadow-sm border-0">

                    <div class="card-body">

                        <h5 class="fw-bold mb-4">
                            Chi tiết hàng nhập
                        </h5>

                        <div class="table-responsive">

                            <table class="table table-bordered align-middle">

                                <thead class="table-light">

                                    <tr>
                                        <th>Tên thuốc</th>
                                        <th>Số lượng</th>
                                        <th>Giá nhập</th>
                                        <th>Số lô</th>
                                        <th>HSD</th>
                                        <th>Xóa</th>
                                    </tr>

                                </thead>

                                <tbody id="chiTietBody">

                                    @if (Model.DanhSachLoHang != null && Model.DanhSachLoHang.Count > 0)
                                    {
                                        @for (int i = 0; i < Model.DanhSachLoHang.Count; i++)
                                        {
                                            <tr>

                                                <td>
                                                    <select asp-for="DanhSachLoHang[i].MaSp"
                                                            asp-items="Model.DsSanPham"
                                                            class="form-select">

                                                        <option value="">
                                                            Chọn thuốc
                                                        </option>

                                                    </select>
                                                </td>

                                                <td>
                                                    <input asp-for="DanhSachLoHang[i].SoLuongNhap"
                                                           class="form-control" />
                                                </td>

                                                <td>
                                                    <input asp-for="DanhSachLoHang[i].GiaNhap"
                                                           class="form-control" />
                                                </td>

                                                <td>
                                                    <input asp-for="DanhSachLoHang[i].SoLo"
                                                           class="form-control" />
                                                </td>

                                                <td>
                                                    <input asp-for="DanhSachLoHang[i].HanSuDung"
                                                           type="date"
                                                           class="form-control" />
                                                </td>

                                                <td class="text-center">
                                                    <button type="button"
                                                            class="btn btn-danger btn-sm btn-remove">
                                                        X
                                                    </button>
                                                </td>

                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>

                                            <td>

                                                <select name="DanhSachLoHang[0].MaSp"
                                                        class="form-select">

                                                    <option value="">
                                                        Chọn thuốc
                                                    </option>

                                                    @foreach (var item in Model.DsSanPham)
                                                    {
                                                        <option value="@item.Value">
                                                            @item.Text
                                                        </option>
                                                    }

                                                </select>

                                            </td>

                                            <td>
                                                <input name="DanhSachLoHang[0].SoLuongNhap"
                                                       class="form-control" />
                                            </td>

                                            <td>
                                                <input name="DanhSachLoHang[0].GiaNhap"
                                                       class="form-control" />
                                            </td>

                                            <td>
                                                <input name="DanhSachLoHang[0].SoLo"
                                                       class="form-control" />
                                            </td>

                                            <td>
                                                <input name="DanhSachLoHang[0].HanSuDung"
                                                       type="date"
                                                       class="form-control" />
                                            </td>

                                            <td class="text-center">
                                                <button type="button"
                                                        class="btn btn-danger btn-sm btn-remove">
                                                    X
                                                </button>
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                        <button type="button"
                                id="btnThemDong"
                                class="btn btn-outline-primary mt-2">

                            <i class="bi bi-plus-circle"></i>
                            Thêm mặt hàng

                        </button>

                    </div>

                </div>

            </div>

            <!-- BÊN PHẢI -->
            <div class="col-lg-4">

                <div class="card shadow-sm border-0 mb-4">

                    <div class="card-body">

                        <h5 class="fw-bold">
                            Tổng kết
                        </h5>

                        <hr />

                        <button type="submit"
                                class="btn btn-primary w-100">

                            <i class="bi bi-save"></i>
                            Lưu phiếu nhập

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        window.__dsSanPham = @Html.Raw(
                                    System.Text.Json.JsonSerializer.Serialize(
                                                    Model.DsSanPham.Select(x => new { value = x.Value, text = x.Text })
                                    )
                    );
    </script>
    <script src="~/js/PhieuNhaps.js"></script>
}