@model DuAnCuoiKy_QuanLyHieuThuoc.Models.ViewModels.PhieuNhapCreateViewModel

@{
    ViewData["Title"] = "Tạo phiếu nhập";
    Layout = "_Layout";
}

<div class="container-fluid py-4 px-4 bg-light min-vh-100">

    <!-- TITLE -->
    <div class="mb-4">
        <div class="text-muted small mb-1">
            Quản lý kho / Nhập kho Dược phẩm
        </div>

        <h2 class="fw-bold mb-0">
            Tạo phiếu nhập hàng
        </h2>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-4">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]
        </div>
    }

    <!-- HIỂN THỊ LỖI -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-4 mb-4">
            <div class="fw-bold mb-2">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                Vui lòng kiểm tra lại thông tin:
            </div>

            <ul class="mb-0">
                @foreach (var item in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@item.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form asp-action="Create" method="post">

        <div class="row g-4">

            <!-- LEFT -->
            <div class="col-lg-8">

                <!-- THÔNG TIN -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">

                    <div class="card-body p-4">

                        <h5 class="fw-bold mb-4">
                            Thông tin chứng từ
                        </h5>

                        <div class="row g-3">

                            <!-- NCC -->
                            <div class="col-md-4">

                                <label class="form-label fw-semibold">
                                    Nhà cung cấp
                                </label>

                                <select asp-for="MaNcc"
                                        asp-items="Model.DsNhaCungCap"
                                        class="form-select rounded-3">

                                    <option value="">
                                        -- Chọn nhà cung cấp --
                                    </option>

                                </select>

                            </div>

                            <!-- NGÀY -->
                            <div class="col-md-4">

                                <label class="form-label fw-semibold">
                                    Ngày nhập kho
                                </label>

                                <input type="date"
                                       class="form-control rounded-3"
                                       value="@DateTime.Now.ToString("yyyy-MM-dd")" />

                            </div>

                            <!-- NHÂN VIÊN -->
                            <div class="col-md-4">

                                <label class="form-label fw-semibold">
                                    Nhân viên kho
                                </label>

                                <input type="text"
                                       class="form-control rounded-3"
                                       value="Phạm Văn Bình"
                                       readonly />

                            </div>

                        </div>

                    </div>

                </div>

                <!-- CHI TIẾT -->
                <div class="card border-0 shadow-sm rounded-4">

                    <div class="card-body p-4">

                        <h5 class="fw-bold mb-4">
                            Chi tiết hàng nhập
                        </h5>

                        <div class="table-responsive">

                            <table class="table align-middle">

                                <thead class="table-light">

                                    <tr>
                                        <th style="min-width:220px;">Tên thuốc</th>
                                        <th style="width:120px;">Số lượng</th>
                                        <th style="width:140px;">Giá nhập</th>
                                        <th style="width:140px;">Số lô</th>
                                        <th style="width:170px;">HSD</th>
                                        <th style="width:140px;">Thành tiền</th>
                                    </tr>

                                </thead>

                                <tbody>

                                    @for (int i = 0; i < Model.DanhSachLoHang.Count; i++)
                                    {
                                        <tr>

                                            <!-- TÊN -->
                                            <td>

                                                <select asp-for="DanhSachLoHang[i].MaSp"
                                                        asp-items="Model.DsSanPham"
                                                        class="form-select rounded-3">

                                                    <option value="">
                                                        Chọn thuốc
                                                    </option>

                                                </select>

                                            </td>

                                            <!-- SỐ LƯỢNG -->
                                            <td>

                                                <input asp-for="DanhSachLoHang[i].SoLuongNhap"
                                                       class="form-control rounded-3"
                                                       placeholder="SL" />

                                            </td>

                                            <!-- GIÁ -->
                                            <td>

                                                <input asp-for="DanhSachLoHang[i].GiaNhap"
                                                       class="form-control rounded-3"
                                                       placeholder="0" />

                                            </td>

                                            <!-- SỐ LÔ -->
                                            <td>

                                                <input asp-for="DanhSachLoHang[i].SoLo"
                                                       class="form-control rounded-3"
                                                       placeholder="LOT..." />

                                            </td>

                                            <!-- HSD -->
                                            <td>

                                                @{
                                                    bool loiHan =
                                                    Model.DanhSachLoHang[i].HanSuDung
                                                    <= DateOnly.FromDateTime(DateTime.Now);
                                                }

                                                <input asp-for="DanhSachLoHang[i].HanSuDung"
                                                       type="date"
                                                       class="form-control rounded-3 @(loiHan ? "border-danger bg-danger-subtle" : "")" />

                                                @if (loiHan)
                                                {
                                                    <div class="text-danger small mt-1">
                                                        Hạn sử dụng phải lớn hơn ngày hiện tại
                                                    </div>
                                                }

                                            </td>

                                            <!-- THÀNH TIỀN -->
                                            <td class="fw-semibold text-end">

                                                @{
                                                    decimal tien =
                                                    Model.DanhSachLoHang[i].GiaNhap
                                                    *
                                                    Model.DanhSachLoHang[i].SoLuongNhap;
                                                }

                                                @tien.ToString("N0") đ

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                        <!-- BUTTON -->
                        <div class="d-flex justify-content-between mt-4">

                            <button type="button"
                                    class="btn btn-light border rounded-3">

                                <i class="bi bi-plus-circle me-2"></i>
                                Thêm mặt hàng

                            </button>

                            <div class="d-flex gap-2">

                                <a asp-action="Index"
                                   class="btn btn-light border rounded-3 px-4">

                                    Hủy bỏ

                                </a>

                                <button type="submit"
                                        class="btn btn-primary rounded-3 px-4">

                                    <i class="bi bi-floppy me-2"></i>
                                    Lưu phiếu nhập

                                </button>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- RIGHT -->
            <div class="col-lg-4">

                <!-- TỔNG KẾT -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">

                    <div class="card-body p-4">

                        <h5 class="fw-bold mb-4">
                            Tổng kết thanh toán
                        </h5>

                        @{
                            decimal tongTien =
                            Model.DanhSachLoHang.Sum(x =>
                            x.GiaNhap * x.SoLuongNhap);

                            decimal vat = tongTien * 0.05m;
                            decimal tongCong = tongTien + vat;
                        }

                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">
                                Tạm tính:
                            </span>

                            <span class="fw-semibold">
                                @tongTien.ToString("N0") đ
                            </span>
                        </div>

                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">
                                VAT (5%)
                            </span>

                            <span class="fw-semibold">
                                @vat.ToString("N0") đ
                            </span>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between">

                            <span class="fw-bold">
                                Tổng cộng:
                            </span>

                            <span class="fw-bold text-primary fs-5">
                                @tongCong.ToString("N0") đ
                            </span>

                        </div>

                    </div>

                </div>

                <!-- CẢNH BÁO -->
                <div class="alert alert-warning border-0 rounded-4 shadow-sm">

                    <div class="fw-bold mb-2">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        Cảnh báo tồn kho
                    </div>

                    <div class="small">
                        Lô thuốc Amoxicillin 250mg có HSD cận ngày
                        (15/12/2025). Vui lòng kiểm tra lại chính sách nhập hàng.
                    </div>

                </div>

                <!-- GẦN ĐÂY -->
                <div class="card border-0 shadow-sm rounded-4">

                    <div class="card-body p-4">

                        <h5 class="fw-bold mb-4">
                            Phiếu nhập gần đây
                        </h5>

                        <div class="border rounded-4 p-3 mb-3">

                            <div class="fw-bold text-primary small">
                                PN-231024-01
                            </div>

                            <div class="small text-muted">
                                Dược phẩm TW1 • 24/10
                            </div>

                            <span class="badge bg-success-subtle text-success mt-2">
                                HOÀN THÀNH
                            </span>

                        </div>

                        <div class="border rounded-4 p-3">

                            <div class="fw-bold text-primary small">
                                PN-231022-03
                            </div>

                            <div class="small text-muted">
                                Dược Hậu Giang • 22/10
                            </div>

                            <span class="badge bg-success-subtle text-success mt-2">
                                HOÀN THÀNH
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </form>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}