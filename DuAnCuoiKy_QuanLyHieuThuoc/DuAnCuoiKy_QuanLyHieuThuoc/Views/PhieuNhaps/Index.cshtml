@{
    ViewData["Title"] = "Lịch sử phiếu nhập";
    Layout = "_Layout";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="fw-bold">
                Lịch sử phiếu nhập
            </h3>

            <div class="text-muted small">
                Quản lý các đợt nhập hàng
            </div>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-circle me-2"></i>
            Tạo phiếu nhập

        </a>

    </div>

    <!-- FILTER -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">

        <form method="get">

            <div class="row g-3">

                <div class="col-md-4">

                    <label class="form-label fw-semibold">
                        Nhà cung cấp
                    </label>

                    <select name="maNcc"
                            asp-items="ViewBag.DsNCC"
                            class="form-select">

                        <option value="">
                            -- Tất cả --
                        </option>

                    </select>

                </div>

                <div class="col-md-3">

                    <label class="form-label fw-semibold">
                        Từ ngày
                    </label>

                    <input type="date"
                           name="tuNgay"
                           class="form-control" />

                </div>

                <div class="col-md-3">

                    <label class="form-label fw-semibold">
                        Đến ngày
                    </label>

                    <input type="date"
                           name="denNgay"
                           class="form-control" />

                </div>

                <div class="col-md-2 d-flex align-items-end">

                    <button class="btn btn-primary w-100">

                        <i class="bi bi-search me-2"></i>
                        Lọc

                    </button>

                </div>

            </div>

        </form>

    </div>

    <!-- TABLE -->
    <div class="card border-0 shadow-sm rounded-4 p-4">

        <div class="table-responsive">

            <table class="table align-middle table-hover">

                <thead class="table-light">

                    <tr>

                        <th>Mã phiếu</th>
                        <th>Ngày nhập</th>
                        <th>Nhà cung cấp</th>
                        <th>Số mặt hàng</th>
                        <th class="text-end">
                            Tổng tiền
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in ViewBag.DsPhieuNhap)
                    {
                        <tr>

                            <td class="fw-bold text-primary">
                                @item.MaPhieu
                            </td>

                            <td>
                                @item.NgayNhap.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @item.TenNcc
                            </td>

                            <td>
                                @item.SoMatHang
                            </td>

                            <td class="text-end fw-bold">

                                @String.Format("{0:N0}", item.TongTien)
                                đ

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>