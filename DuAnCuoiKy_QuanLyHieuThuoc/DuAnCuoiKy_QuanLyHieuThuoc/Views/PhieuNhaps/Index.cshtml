                                <td class="text-end">1,200</td>
                                <td class="text-center">L2309A</td>
                                <td class="text-center">09/2026</td>
                                <td class="text-end">120,000</td>
                            </tr>

                            <tr>
                                <td>Amoxicillin 250mg</td>
                                <td class="text-center">50</td>
                                <td class="text-end">3,500</td>
                                <td class="text-center">L2310B</td>
                                <td class="text-center">10/2025</td>
                                <td class="text-end">175,000</td>
                            </tr>

                            <tr>
                                <td>Vitamin C 1000mg</td>
                                <td class="text-center">200</td>
                                <td class="text-end">2,000</td>
                                <td class="text-center">VC882</td>
                                <td class="text-center">12/2025</td>
                                <td class="text-end">400,000</td>
                            </tr>

                        </tbody>

                        <tfoot class="table-light">
                            <tr>
                                <th colspan="5" class="text-end">
                                    Tổng cộng:
                                </th>

                                <th class="text-end text-primary fw-bold">
                                    695,000
                                </th>
                            </tr>
                        </tfoot>

                    </table>

                </div>

            </div>

            <div class="modal-footer border-0 px-4 pb-4">

                <button type="button"
                        class="btn btn-light border px-4"
                        data-bs-dismiss="modal">
                    Đóng
                </button>

                <button type="button"
                        class="btn btn-primary px-4">
                    <i class="bi bi-printer me-2"></i>
                    In phiếu
                </button>

            </div>

