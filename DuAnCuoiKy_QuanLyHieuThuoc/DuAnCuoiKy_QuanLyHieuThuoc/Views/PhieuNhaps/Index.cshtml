@{
    ViewData["Title"] = "Lịch sử phiếu nhập";
    Layout = "_Layout";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between mb-4">

        <div>
            <h3 class="fw-bold mb-1">
                Lịch sử phiếu nhập
            </h3>

            <div class="text-muted">
                Quản lý các đợt nhập hàng
            </div>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-lg"></i>
            Tạo phiếu mới

        </a>

    </div>

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body">

            <form method="get">

                <div class="row mb-4">

                    <div class="col-md-4">

                        <input type="text"
                               name="keyword"
                               value="@(Context.Request.Query["keyword"])"
                               class="form-control"
                               placeholder="Tìm mã phiếu..." />

                    </div>

                    <div class="col-md-3">

                        <input type="date"
                               name="tuNgay"
                               value="@(Context.Request.Query["tuNgay"])"
                               class="form-control" />

                    </div>

                    <div class="col-md-3">

                        <input type="date"
                               name="denNgay"
                               value="@(Context.Request.Query["denNgay"])"
                               class="form-control" />

                    </div>

                    <div class="col-md-2">

                        <button class="btn btn-primary w-100">
                            Lọc
                        </button>

                    </div>

                </div>

            </form>

            <table class="table table-hover align-middle">

                <thead class="table-light">

                    <tr>
                        <th>Mã phiếu</th>
                        <th>Ngày nhập</th>
                        <th>Nhà cung cấp</th>
                        <th>Số mặt hàng</th>
                        <th>Tổng tiền</th>
                        <th width="80">Chi tiết</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in ViewBag.DsPhieuNhap)
                    {
                        <tr>

                            <td class="fw-bold text-primary">
                                @item.MaPhieu
                            </td>

                            <td>
                                @item.NgayNhap.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @item.TenNcc
                            </td>

                            <td>
                                @item.SoMatHang
                            </td>

                            <td class="fw-bold">

                                @String.Format("{0:N0}", item.TongTien) đ

                            </td>

                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@item.MaPhieu"
                                   class="btn btn-sm btn-outline-primary">

                                    <i class="bi bi-eye"></i>

                                </a>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>