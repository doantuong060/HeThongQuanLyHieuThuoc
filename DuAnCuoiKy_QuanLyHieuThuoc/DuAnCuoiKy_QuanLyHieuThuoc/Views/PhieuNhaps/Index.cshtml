@model IEnumerable<DuAnCuoiKy_QuanLyHieuThuoc.Models.PhieuNhap>

@{
    ViewData["Title"] = "Danh sách phiếu";
    Layout = "~/Views/Shared/_LayoutNhanVienKho.cshtml";
}

<!-- Breadcrumb -->
<div class="kho-breadcrumb">
    <i class="bi bi-grid-1x2" style="font-size:12px;"></i>
    <span>Quản lý kho</span>
    <i class="bi bi-chevron-right" style="font-size:10px;"></i>
    <span class="current">Lịch sử phiếu nhập</span>
</div>

<div class="d-flex align-items-start justify-content-between mb-4" style="gap:16px;">
    <div>
        <div class="kho-page-title">Lịch sử phiếu nhập</div>
        <div class="kho-page-subtitle">Quản lý và tra cứu các phiếu nhập kho từ nhà cung cấp.</div>
    </div>
    <a asp-controller="PhieuNhaps" asp-action="Create" class="kho-btn-primary" style="white-space:nowrap;">
        <i class="bi bi-plus-lg"></i> Tạo phiếu mới
    </a>
</div>

<!-- Toolbar -->
<div class="kho-table-card">
    <div class="kho-table-toolbar">
        <div class="kho-search-input">
            <i class="bi bi-search" style="color:#9ca3af;font-size:13px;"></i>
            <input type="text" placeholder="Tìm mã phiếu..." />
        </div>

        <select class="kho-filter-select">
            <option>NCC</option>
            <option>Traphaco</option>
            <option>Dược Hậu Giang</option>
            <option>Trung ương 1</option>
        </select>

        <div class="kho-btn-outline">
            <i class="bi bi-calendar3" style="font-size:13px;"></i>
            Tháng này
        </div>

        <select class="kho-filter-select">
            <option>Trạng thái</option>
            <option>Đã nhập kho</option>
            <option>Chờ duyệt</option>
            <option>Đã hủy</option>
        </select>
    </div>

    <table class="kho-table-main">
        <thead>
            <tr>
                <th>Mã phiếu</th>
                <th>Ngày nhập</th>
                <th>Nhà cung cấp</th>
                <th style="text-align:center;">Số mặt hàng</th>
                <th style="text-align:right;">Tổng tiền</th>
                <th>Trạng thái</th>
                <th style="text-align:center;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><a href="#" class="pn-code-link">PN-20231024-01</a></td>
                <td style="color:#6b7280;font-size:12px;">24/10/2023 09:30</td>
                <td>Công ty Dược phẩm Trung ương I</td>
                <td style="text-align:center;">15</td>
                <td style="text-align:right;font-family:monospace;font-weight:600;">125.400.000 đ</td>
                <td><span class="pn-status-badge da-nhap">Đã nhập kho</span></td>
                <td style="text-align:center;">

                    <button class="act-view-btn mx-auto border-0"
                            data-bs-toggle="modal"
                            data-bs-target="#modalChiTietPhieuNhap">

                        <i class="bi bi-eye"></i>

                    </button>

                </td>
            </tr>
            <tr>
                <td><a href="#" class="pn-code-link">PN-20231024-02</a></td>
                <td style="color:#6b7280;font-size:12px;">24/10/2023 14:15</td>
                <td>Nhà phân phối Thuốc Việt</td>
                <td style="text-align:center;">8</td>
                <td style="text-align:right;font-family:monospace;font-weight:600;">45.200.000 đ</td>
                <td><span class="pn-status-badge cho-duyet">Chờ duyệt</span></td>
                <td style="text-align:center;">

                    <button class="act-view-btn mx-auto border-0"
                            data-bs-toggle="modal"
                            data-bs-target="#modalChiTietPhieuNhap">

                        <i class="bi bi-eye"></i>

                    </button>

                </td>
            </tr>
            <tr>
                <td><a href="#" class="pn-code-link">PN-20231023-01</a></td>
                <td style="color:#6b7280;font-size:12px;">23/10/2023 10:00</td>
                <td>Dược Hậu Giang</td>
                <td style="text-align:center;">42</td>
                <td style="text-align:right;font-family:monospace;font-weight:600;">310.500.000 đ</td>
                <td><span class="pn-status-badge da-nhap">Đã nhập kho</span></td>
                <td style="text-align:center;">

                    <button class="act-view-btn mx-auto border-0"
                            data-bs-toggle="modal"
                            data-bs-target="#modalChiTietPhieuNhap">

                        <i class="bi bi-eye"></i>

                    </button>

                </td>
            </tr>
            <tr>
                <td><a href="#" class="pn-code-link">PN-20231022-03</a></td>
                <td style="color:#6b7280;font-size:12px;">22/10/2023 16:45</td>
                <td>Công ty TNHH Dược phẩm Đông Á</td>
                <td style="text-align:center;">5</td>
                <td style="text-align:right;font-family:monospace;font-weight:600;">12.000.000 đ</td>
                <td><span class="pn-status-badge da-huy">Đã hủy</span></td>
                <td style="text-align:center;">

                    <button class="act-view-btn mx-auto border-0"
                            data-bs-toggle="modal"
