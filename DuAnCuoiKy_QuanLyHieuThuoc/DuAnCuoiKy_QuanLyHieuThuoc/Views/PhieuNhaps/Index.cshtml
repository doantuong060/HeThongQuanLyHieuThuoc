                        <i class="bi bi-eye"></i>

                    </button>

                </td>
            </tr>
            <tr>
                <td><a href="#" class="pn-code-link">PN-20231021-01</a></td>
                <td style="color:#6b7280;font-size:12px;">21/10/2023 08:15</td>
                <td>Traphaco</td>
                <td style="text-align:center;">20</td>
                <td style="text-align:right;font-family:monospace;font-weight:600;">89.600.000 đ</td>
                <td><span class="pn-status-badge da-nhap">Đã nhập kho</span></td>
                <td style="text-align:center;">

                    <button class="act-view-btn mx-auto border-0"
                            data-bs-toggle="modal"
                            data-bs-target="#modalChiTietPhieuNhap">

                        <i class="bi bi-eye"></i>

                    </button>

                </td>
            </tr>
        </tbody>
    </table>

    <div class="kho-pagination">
        <span>Hiển thị 1–5 của 42 phiếu nhập</span>
        <div class="kho-page-btns">
            <a href="#" class="kho-pg-btn">‹</a>
            <a href="#" class="kho-pg-btn active">1</a>
            <a href="#" class="kho-pg-btn">2</a>
            <a href="#" class="kho-pg-btn">3</a>
