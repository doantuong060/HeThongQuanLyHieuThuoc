<div class="modal fade" id="modalThemSP" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header border-0 p-4 pb-0">
                <h5 class="fw-bold mb-0">Thêm sản phẩm mới</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Create" asp-controller="SanPhams" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label small fw-bold text-muted">Tên sản phẩm *</label>
                            <input name="TenSp" class="form-control bg-light border-0 py-2 shadow-none"
                                   placeholder="Nhập tên thuốc hoặc vật tư" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted">Phân loại *</label>
                            <select name="LoaiSp" id="selectLoaiSP"
                                    class="form-select bg-light border-0 py-2 shadow-none">
                                <option value="THUOC">THUỐC</option>
                                <option value="VATTU">VẬT TƯ Y TẾ</option>
                            </select>
                        </div>

                        @* Vùng thông tin THUỐC *@
                        <div class="row g-3 p-0 m-0" id="divThuoc">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">Loại thuốc *</label>
                                <select name="MaLoai" class="form-select bg-light border-0 py-2 shadow-none"
                                        asp-items="ViewBag.MaLoai">
                                    <option value="">Chọn loại thuốc</option>
                                </select>
                            </div>
                            <div class="col-md-6 d-flex align-items-center mt-4">
                                <div class="form-check form-switch mt-2">
                                    <input name="CanToa" type="checkbox"
                                           class="form-check-input" value="true">
                                    <input name="CanToa" type="hidden" value="false">
                                    <label class="form-check-label small fw-bold">Cần đơn thuốc</label>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <label class="form-label small fw-bold text-muted">Ghi chú</label>
                                <input name="GhiChu" class="form-control bg-light border-0 py-2 shadow-none"
                                       placeholder="Ghi chú thêm (nếu có)">
                            </div>
                        </div>

                        @* Vùng thông tin VẬT TƯ *@
                        <div class="row g-3 p-0 m-0 d-none" id="divVatTu">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">Loại vật tư *</label>
                                <select name="MaLoaiVt" class="form-select bg-light border-0 py-2 shadow-none"
                                        asp-items="ViewBag.MaLoaiVt">
                                    <option value="">Chọn loại vật tư</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">Nhà sản xuất</label>
                                <input name="NhaSanXuat" class="form-control bg-light border-0 py-2 shadow-none"
                                       placeholder="Nhập hãng SX">
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted">Đơn vị tính *</label>
                            <select name="MaDvt" class="form-select bg-light border-0 py-2 shadow-none"
                                    asp-items="ViewBag.MaDvt">
                                <option value="">Chọn đơn vị</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted">Giá bán (đ) *</label>
                            <input name="GiaBan" type="number" min="100"
                                   class="form-control bg-light border-0 py-2 shadow-none"
                                   placeholder="0" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted">Ngưỡng cảnh báo</label>
                            <input name="MucCanhBao" type="number" value="20"
                                   class="form-control bg-light border-0 py-2 shadow-none">
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-light px-4 rounded-3 fw-bold"
                            data-bs-dismiss="modal">
                        Hủy bỏ
                    </button>
                    <button type="submit" class="btn btn-primary px-4 rounded-3 fw-bold shadow-sm">
                        Lưu sản phẩm
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
