@using DuAnCuoiKy_QuanLyHieuThuoc.Helpers
@using DuAnCuoiKy_QuanLyHieuThuoc.Enums
@model DuAnCuoiKy_QuanLyHieuThuoc.Models.ViewModels.ProductIndexViewModel

@{
    ViewData["Title"] = "Danh mục sản phẩm";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/sanpham.css" asp-append-version="true" />
}

<div class="p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold">Danh mục sản phẩm</h3>
        <button class="btn btn-primary px-4 rounded-3 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalThemSP">
            <i class="bi bi-plus-lg me-2"></i>Thêm sản phẩm
        </button>
    </div>

    <!-- Hàng thống kê thực tế từ SQL -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 rounded-4">
                <div class="text-muted small fw-bold">TỔNG SẢN PHẨM</div>
                <div class="h2 fw-bold text-dark">@Model.TongSanPham</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 rounded-4 border-start border-4 border-warning">
                <div class="text-muted small fw-bold">SẮP HẾT HÀNG</div>
                <div class="h2 fw-bold text-warning">@Model.SoLuongSapHet</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 rounded-4 border-start border-4 border-danger">
                <div class="text-muted small fw-bold">CẬN HẠN SỬ DỤNG</div>
                <div class="h2 fw-bold text-danger">@Model.SoLuongSapHetHan</div>
            </div>
        </div>
    </div>

    <!-- Bảng sản phẩm -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <form method="get" asp-action="Index" class="p-3 bg-white border-bottom">
            <div class="row g-2">
                <div class="col-md-4">
                    <input type="text" name="search" value="@ViewBag.CurrentSearch" class="form-control border-light bg-light" placeholder="Tìm tên, mã sản phẩm...">
                </div>
                <div class="col-md-2">
                    <select name="loai" class="form-select border-light bg-light" onchange="this.form.submit()">
                        <option value="Tất cả">Tất cả loại</option>
                        <option value="@ProductType.Thuoc" selected="@(ViewBag.CurrentLoai == ProductType.Thuoc)">THUỐC</option>
                        <option value="@ProductType.VatTu" selected="@(ViewBag.CurrentLoai == ProductType.VatTu)">VẬT TƯ</option>
                    </select>
                </div>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table align-middle mb-0 table-hover">
                <thead class="bg-light text-muted small">
                    <tr>
                        <th class="ps-4">MÃ</th>
                        <th>TÊN SẢN PHẨM</th>
                        <th>PHÂN LOẠI</th>
                        <th>GIÁ BÁN</th>
                        <th>TỒN KHO</th>
                        <th class="text-center">TRẠNG THÁI</th>
                        <th class="text-end pe-4">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Products)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-primary small">@item.MaSp</td>
                            <td class="fw-bold">@item.TenSp</td>
                            <td>
                                <span class="badge @(item.LoaiSp == ProductType.Thuoc ? "bg-info" : "bg-secondary") bg-opacity-10 text-@(item.LoaiSp == ProductType.Thuoc ? "info" : "secondary") rounded-pill px-3">
                                    @item.LoaiSp
                                </span>
                            </td>
                            <td class="fw-bold">@CurrencyHelper.ToVnd(item.GiaBan)</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="status-dot @(item.SoLuongTon <= item.MucCanhBao ? "bg-danger" : "bg-success")"></div>
                                    <span class="fw-bold">@item.SoLuongTon</span>
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="badge @(item.TrangThai == true ? "bg-success" : "bg-danger") bg-opacity-10 text-@(item.TrangThai == true ? "success" : "danger") px-2 py-1 rounded">
                                    @(item.TrangThai == true ? "Đang bán" : "Ngừng")
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <button class="btn btn-sm btn-light rounded-circle me-1"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-light rounded-circle text-danger"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<partial name="_ModalThemSanPham" />

@section Scripts {
    <script src="~/js/sanpham.js" asp-append-version="true"></script>
}