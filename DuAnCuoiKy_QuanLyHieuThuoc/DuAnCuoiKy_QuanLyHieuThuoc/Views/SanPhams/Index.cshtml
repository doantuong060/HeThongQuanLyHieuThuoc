@{
    ViewData["Title"] = "Danh mục thuốc";
    Layout = "_Layout";
}

<div class="p-4">
    <!-- Header -->
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a href="#">Hệ thống</a></li>
                <li class="breadcrumb-item active">Danh mục thuốc</li>
            </ol>
        </nav>
        <h3 class="fw-bold">Danh mục thuốc</h3>
    </div>

    <!-- Stats Cards (Ảnh 3) -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 rounded-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-bold">Tổng thuốc trong kho</div>
                        <div class="h3 fw-bold my-1">@ViewBag.TongThuoc</div>
                        <div class="text-success small fw-bold"><i class="bi bi-arrow-up"></i> +12 mt thêm</div>
                    </div>
                    <div class="p-3 bg-primary bg-opacity-10 rounded-3 text-primary"><i class="bi bi-archive fs-4"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 rounded-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-bold">Sắp hết hàng</div>
                        <div class="h3 fw-bold my-1">@ViewBag.SapHetHang</div>
                        <div class="text-warning small fw-bold">12 mã cần nhập gấp</div>
                    </div>
                    <div class="p-3 bg-warning bg-opacity-10 rounded-3 text-warning"><i class="bi bi-exclamation-triangle fs-4"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 rounded-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-bold">Hết hạn trong 30 ngày</div>
                        <div class="h3 fw-bold my-1">@ViewBag.HetHan30Ngay</div>
                        <div class="text-danger small fw-bold"><i class="bi bi-clock"></i> Cần xử lý ngay</div>
                    </div>
                    <div class="p-3 bg-danger bg-opacity-10 rounded-3 text-danger"><i class="bi bi-calendar-x fs-4"></i></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Toolbar: Search & Filter -->
    <div class="card border-0 shadow-sm p-3 mb-4 rounded-4">
        <div class="row g-3 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light border-0"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control bg-light border-0" placeholder="Tìm kiếm thuốc, mã, hoạt chất...">
                </div>
            </div>
            <div class="col-md-2">
                <select class="form-select border-light bg-light">
                    <option>Lọc theo loại</option>
                </select>
            </div>
            <div class="col-md-6 text-end">
                <button class="btn btn-light border-0 px-3 me-2"><i class="bi bi-sliders me-2"></i>Bộ lọc nâng cao</button>
                <button class="btn btn-primary px-4" data-bs-toggle="modal" data-bs-target="#modalThemThuoc">
                    <i class="bi bi-plus-lg me-2"></i>Thêm thuốc
                </button>
            </div>
        </div>
    </div>

    <!-- Table Danh mục -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0 table-hover">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 text-muted small">MÃ</th>
                        <th class="text-muted small">TÊN THUỐC & HOẠT CHẤT</th>
                        <th class="text-muted small">LOẠI</th>
                        <th class="text-muted small">ĐVT</th>
                        <th class="text-muted small">GIÁ BÁN</th>
                        <th class="text-muted small">TỒN KHO</th>
                        <th class="text-muted small text-center">CẦN TOA</th>
                        <th class="text-muted small text-end pe-4">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ViewBag.DanhSachThuoc)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-primary small">@item.Ma</td>
                            <td>
                                <div class="fw-bold">@item.Ten</div>
                                <div class="text-muted small">@item.HoatChat</div>
                            </td>
                            <td><span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3">@item.Loai</span></td>
                            <td>@item.DVT</td>
                            <td class="fw-bold">@item.Gia đ</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-@item.Status" style="width: 8px; height: 8px;"></div>
                                    <span class="fw-bold">@item.Ton</span>
                                </div>
                            </td>
                            <td class="text-center">
                                @if (item.CanToa)
                                {
                                    <i class="bi bi-check-lg text-success fs-5"></i>
                                }
                                else
                                {

                                    <i class="bi bi-x-lg text-muted opacity-50"></i>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <button class="btn btn-sm btn-light text-muted me-1"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-light text-danger"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <!-- Pagination -->
        <div class="p-3 border-top d-flex justify-content-between align-items-center">
            <span class="small text-muted">Hiển thị 1-5 của 1,245 kết quả</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item disabled"><a class="page-link" href="#"><i class="bi bi-chevron-left"></i></a></li>
                <li class="page-item active"><a class="page-link" href="#">1</a></li>
                <li class="page-item"><a class="page-link" href="#">2</a></li>
                <li class="page-item"><a class="page-link" href="#">3</a></li>
                <li class="page-item"><a class="page-link" href="#"><i class="bi bi-chevron-right"></i></a></li>
            </ul>
        </div>
    </div>
</div>

<!-- MODAL THÊM THUỐC MỚI (Ảnh Extra) -->
<div class="modal fade" id="modalThemThuoc" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow" style="border-radius: 20px;">
            <div class="modal-header border-0 p-4 pb-0">
                <h5 class="fw-bold mb-0">Thêm thuốc mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Tên thuốc *</label>
                            <input type="text" class="form-control bg-light border-0 py-2" placeholder="Nhập tên thuốc">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Loại thuốc *</label>
                            <select class="form-select bg-light border-0 py-2" asp-items="ViewBag.LoaiThuoc"></select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Đơn vị tính *</label>
                            <select class="form-select bg-light border-0 py-2" asp-items="ViewBag.DonViTinh"></select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Giá bán (đ) *</label>
                            <input type="number" class="form-control bg-light border-0 py-2" value="0">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Tồn kho hiện tại</label>
                            <input type="number" class="form-control bg-light border-0 py-2" value="0">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Ngưỡng cảnh báo *</label>
                            <input type="number" class="form-control bg-light border-0 py-2" value="10">
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold text-muted">Nhà sản xuất</label>
                            <input type="text" class="form-control bg-light border-0 py-2" placeholder="Nhập tên nhà sản xuất">
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold text-muted">Ghi chú</label>
                            <textarea class="form-control bg-light border-0" rows="3" placeholder="Nhập ghi chú thêm về thuốc..."></textarea>
                        </div>

                        <!-- Switches -->
                        <div class="col-md-12 mt-4 pt-3 border-top">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <div class="fw-bold small">Cần đơn thuốc</div>
                                    <div class="text-muted" style="font-size: 11px;">Thuốc yêu cầu bác sĩ kê đơn</div>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" style="width: 40px; height: 20px;">
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-bold small">Theo dõi hạn dùng</div>
                                    <div class="text-muted" style="font-size: 11px;">Cảnh báo khi có lô sắp hết hạn</div>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" checked style="width: 40px; height: 20px;">
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 p-4 pt-0 mt-3">
                <button type="button" class="btn btn-light px-4 rounded-3" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" class="btn btn-primary px-4 rounded-3">Lưu thuốc <i class="bi bi-arrow-right ms-2"></i></button>
            </div>
        </div>
    </div>
</div>