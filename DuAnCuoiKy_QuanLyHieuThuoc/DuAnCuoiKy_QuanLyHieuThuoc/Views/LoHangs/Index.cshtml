@{
    ViewData["Title"] = "Tồn kho & Cảnh báo";
    Layout = "_Layout";
    string activeTab = ViewBag.ActiveTab ?? "all";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_KhoTonKho.css" asp-append-version="true" />
}

<div class="inventory-container p-4">
    <!-- Header -->
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item">
                    <a href="/TongQuanKho" class="text-decoration-none text-muted">Quản lý kho</a>
                </li>
                <li class="breadcrumb-item active fw-bold">Tình trạng tồn kho</li>
            </ol>
        </nav>
        <h3 class="fw-bold text-dark">Tồn kho & Cảnh báo</h3>
    </div>

    <div class="row g-4">
        <!-- CỘT TRÁI -->
        <div class="col-md-9">

            <!-- Tabs Lọc -->
            <ul class="nav inventory-tabs mb-3 border-bottom">
                <li class="nav-item">
                    <a class="nav-link @(activeTab == "all" ? "active" : "")"
                       href="@Url.Action("Index", new { tab = "all", keyword = ViewBag.Keyword })">
                        Tất cả thuốc
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(activeTab == "saphet" ? "active" : "")"
                       href="@Url.Action("Index", new { tab = "saphet", keyword = ViewBag.Keyword })">
                        Sắp hết hàng (@ViewBag.SapHetHangCount)
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(activeTab == "saphetan" ? "active" : "")"
                       href="@Url.Action("Index", new { tab = "saphetan", keyword = ViewBag.Keyword })">
                        Sắp hết hạn (@ViewBag.NguyCapCount)
                    </a>
                </li>
            </ul>

            <!-- Toolbar Search -->
            <form method="get" asp-action="Index">
                <input type="hidden" name="tab" value="@activeTab" />
                <div class="d-flex justify-content-between mb-3">
                    <div class="input-group shadow-sm" style="max-width: 400px;">
                        <span class="input-group-text bg-white border-0 ps-3">
                            <i class="bi bi-search text-muted small"></i>
                        </span>
                        <input type="text"
                               name="keyword"
                               value="@ViewBag.Keyword"
                               class="form-control border-0 py-2 small shadow-none"
                               placeholder="Tìm kiếm theo mã, tên thuốc..." />
                        <button type="submit" class="btn btn-white bg-white border shadow-sm px-3 small">
                            Tìm
                        </button>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-white bg-white border shadow-sm px-3 small">
                            <i class="bi bi-filter me-2"></i>Lọc
                        </button>
                        <button type="button" class="btn btn-white bg-white border shadow-sm px-3 small">
                            <i class="bi bi-upload me-2"></i>Xuất file
                        </button>
                    </div>
                </div>
            </form>

            <!-- Bảng dữ liệu -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="table-responsive">
                    <table class="table align-middle mb-0 table-hover table-inventory">
                        <thead>
                            <tr>
                                <th class="ps-4">MÃ</th>
                                <th>TÊN THUỐC</th>
                                <th>LOẠI</th>
                                <th>ĐVT</th>
                                <th>TỒN KHO / NGƯỠNG</th>
                                <th>LÔ GẦN HSD</th>
                                <th>TRẠNG THÁI</th>
                                <th class="text-center"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in ViewBag.DsTonKho)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-muted small">@item.Ma</td>
                                    <td class="fw-bold text-dark">@item.Ten</td>
                                    <td class="small text-muted">@item.Loai</td>
                                    <td class="small text-dark">@item.DVT</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <span class="fw-bold text-dark small">@item.Ton</span>
                                            <span class="text-muted small">/ @item.Nguong</span>
                                        </div>
                                        <div class="progress progress-ton">
                                            <div class="progress-bar bg-@item.Class"
                                                 style="width: @item.Progress%"></div>
                                        </div>
                                    </td>
                                    <td class="small text-muted">
                                        @if (item.Class == "danger")
                                        {
                                            <span class="text-danger">
                                                <i class="bi bi-clock-history me-1"></i>@item.LoGanHSD
                                            </span>
                                        }
                                        else
                                        {
                                            <span>@item.LoGanHSD</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-@item.Class bg-opacity-10 text-@item.Class px-3 rounded-pill fw-bold"
                                              style="font-size: 10px;">
                                            @item.Status
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-link text-muted p-0">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="p-3 bg-white border-top text-muted small">
                    Hiển thị @ViewBag.DsTonKho.Count kết quả
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI -->
        <div class="col-md-3">
            <div class="summary-card shadow-sm p-4">
                <h6 class="fw-bold mb-4">
                    <i class="bi bi-bar-chart-fill text-primary me-2"></i>Tổng quan tồn kho
                </h6>

                <div class="p-3 mb-4 rounded-4" style="background-color: #f8faff;">
                    <div class="text-muted small fw-bold">TỔNG MÃ THUỐC</div>
                    <div class="h2 fw-bold text-dark mb-0">@ViewBag.TongMaThuoc</div>
                </div>

                <div class="mb-4">
                    <div class="d-flex justify-content-between mb-2 small">
                        <span><span class="status-indicator bg-success"></span>An toàn</span>
                        <span class="fw-bold">@ViewBag.AnToanCount</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 small">
                        <span><span class="status-indicator bg-warning"></span>Sắp hết hàng</span>
                        <span class="fw-bold">@ViewBag.SapHetHangCount</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 small">
                        <span><span class="status-indicator bg-danger"></span>Nguy cấp</span>
                        <span class="fw-bold">@ViewBag.NguyCapCount</span>
                    </div>
                </div>

                <hr class="my-4 opacity-50">

                <a href="/PhieuNhaps/Create" class="btn btn-primary w-100 py-2 rounded-3 fw-bold shadow-sm">
                    <i class="bi bi-plus-lg me-2"></i>Tạo phiếu nhập
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/_KhoTonKho.js" asp-append-version="true"></script>
}