@model IEnumerable<DuAnCuoiKy_QuanLyHieuThuoc.Models.PhuongXa>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TenPhuongXa)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaTinhThanhNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.TenPhuongXa)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MaTinhThanhNavigation.MaTinhThanh)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.MaPhuongXa">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.MaPhuongXa">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.MaPhuongXa">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
