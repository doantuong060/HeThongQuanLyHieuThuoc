@model IEnumerable<DuAnCuoiKy_QuanLyHieuThuoc.Models.VwTonKhoSanPham>
@using DuAnCuoiKy_QuanLyHieuThuoc.Models
@using DuAnCuoiKy_QuanLyHieuThuoc.Helpers
@using DuAnCuoiKy_QuanLyHieuThuoc.Extensions
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment

@{
    ViewData["Title"] = "Bán hàng POS - MedVault";
    var cart = ViewBag.Cart as List<CartItem>;
}

@section Styles {
    <link rel="stylesheet" href="~/css/_BanHang.css" asp-append-version="true" />
}

<div class="pos-wrapper">

    <div class="pos-products">

        <div class="pos-breadcrumb">
            <a href="#">Bán hàng</a>
            <span class="sep">›</span>
            <span>Quầy bán lẻ</span>
        </div>

        <div class="pos-toolbar">
            <form method="get" id="searchForm">
                <div class="search-row">
                    <div class="search-box">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="text"
                               name="keyword"
                               id="searchInput"
                               value="@ViewBag.Keyword"
                               placeholder="Tìm tên thuốc..." />
                    </div>

                    <select class="select-category" id="categorySelect" name="loai">
                        <option value="" selected="@(string.IsNullOrEmpty(ViewBag.SelectedLoai))">Tất cả danh mục</option>
                        @if (ViewBag.DanhMucs != null)
                        {
                            foreach (var dm in ViewBag.DanhMucs)
                            {
                                <option value="@dm" selected="@(ViewBag.SelectedLoai == dm)">@dm</option>
                            }
                        }
                    </select>
                </div>

                <div class="filter-tags mt-2">
                    <a href="#" class="filter-tag @(string.IsNullOrEmpty(ViewBag.SelectedLoai) ? "active" : "")" data-category="">Tất cả</a>
                    @if (ViewBag.DanhMucs != null)
                    {
                        foreach (var dm in ViewBag.DanhMucs)
                        {
                            <a href="#" class="filter-tag @(ViewBag.SelectedLoai == dm ? "active" : "")" data-category="@dm">@dm</a>
                        }
                    }
                </div>
            </form>
        </div>

        <div class="products-grid">
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    // Logic check tồn kho trực tiếp từ View SQL vw_TonKhoSanPham
                    var outOfStock = item.SoLuongTon <= 0;
                    <div class="product-card @(outOfStock ? "out-of-stock" : "")">

                        <div class="product-img">
                            @{
                                string imgPath = ImageHelper.GetProductImagePath(WebHostEnvironment, item.MaSp);
                            }
    
                            @if (!string.IsNullOrEmpty(imgPath))
                            {
                                <img src="@imgPath" alt="@item.TenSp" />
                            }
                            else
                            {
                                <i class="fa-solid fa-pills"></i>
                            }
                        </div>

                        <div class="product-name">@item.TenSp</div>
                        <div class="product-desc">@item.LoaiSp - Đơn vị: @item.TenDvt</div>
                        
                        <div class="product-stock @(outOfStock ? "empty" : (item.SoLuongTon <= item.MucCanhBao ? "low" : "ok"))">
                            @(outOfStock ? "Hết hàng" : $"Tồn: {item.SoLuongTon} {item.TenDvt.ToLower()}")
                        </div>

                        <div class="product-footer">
                            <div class="product-price">@CurrencyHelper.FormatVND(item.GiaBan)</div>
                            
                            @if (!outOfStock)
                            {
                                <a asp-action="AddToCart"
                                       asp-route-id="@item.MaSp"
                                       asp-route-keyword="@ViewBag.Keyword"
                                       asp-route-loai="@ViewBag.SelectedLoai"
                                       class="btn-add-cart">
                                    <i class="fa-solid fa-cart-plus"></i>
                                </a>
                            }
                            else
                            {
                                <button class="btn-add-cart disabled">
                                    <i class="fa-solid fa-cart-arrow-down"></i>
                                </button>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center text-muted mt-5">
                    <i class="fa-solid fa-box-open fs-1 mb-3"></i>
                    <p>Không tìm thấy sản phẩm nào phù hợp.</p>
                </div>
            }
        </div>
    </div>

    <div class="pos-cart">

        <div class="cart-header">
            <div class="cart-title">
                <i class="fa-solid fa-cart-shopping"></i>
                Giỏ hàng <span class="cart-count">@(cart?.Sum(x => x.SoLuong) ?? 0)</span>
            </div>
            <a asp-action="ClearCart"
               asp-route-keyword="@ViewBag.Keyword"
               asp-route-loai="@ViewBag.SelectedLoai"
               class="btn-clear-cart">Xóa tất cả</a>
        </div>

        <div class="cart-customer">
            <div class="customer-row">
                <div class="customer-avatar">
                    <i class="fa-solid fa-user"></i>
                </div>
                <div class="customer-info">
                    <div class="customer-name">Khách lẻ (Mặc định)</div>
                    <div class="customer-sub">Thêm thông tin khách hàng</div>
                </div>
                <i class="fa-solid fa-chevron-right text-muted" style="font-size: 12px;"></i>
            </div>
        </div>

        <div class="cart-items">
            @if (cart != null && cart.Count > 0)
            {
                foreach (var item in cart)
                {
                    <div class="cart-item">
                        <div class="cart-item-icon" style="overflow: hidden;">
                            @{
                                // Quét ảnh tự động cho giỏ hàng
                                string cartImgPath = ImageHelper.GetProductImagePath(WebHostEnvironment, item.MaSP);
                            }
                            @if (!string.IsNullOrEmpty(cartImgPath))
                            {
                                <img src="@cartImgPath" alt="@item.TenSP" style="width: 100%; height: 100%; object-fit: cover;" />
                            }
                            else
                            {
                                <i class="fa-solid fa-prescription-bottle-medical" style="color: var(--gray-400); font-size: 14px;"></i>
                            }
                        </div>

                        <div>
                            <div class="cart-item-name" title="@item.TenSP">@item.TenSP</div>
                            <div class="cart-item-price">@CurrencyHelper.FormatVND(item.GiaBan)</div>

                            <div class="qty-control">
                                <a asp-action="DecreaseQuantity"
                                   asp-route-id="@item.MaSP"
                                   asp-route-keyword="@ViewBag.Keyword"
                                   asp-route-loai="@ViewBag.SelectedLoai"
                                   class="qty-btn">-</a>
                                <div class="qty-value">@item.SoLuong</div>
                                <a asp-action="IncreaseQuantity"
                                   asp-route-id="@item.MaSP"
                                   asp-route-keyword="@ViewBag.Keyword"
                                   asp-route-loai="@ViewBag.SelectedLoai"
                                   class="qty-btn">+</a>
                            </div>
                        </div>

                        <div class="cart-item-right">
                            <a asp-action="RemoveItem"
                                   asp-route-id="@item.MaSP"
                                   asp-route-keyword="@ViewBag.Keyword"
                                   asp-route-loai="@ViewBag.SelectedLoai"
                                   class="btn-remove-item">
                                <i class="fa-solid fa-xmark"></i>
                            </a>
                            <div class="cart-item-subtotal">@CurrencyHelper.FormatVND(item.ThanhTien)</div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="cart-empty">
                    <i class="fa-solid fa-basket-shopping text-gray-300 mb-2" style="font-size: 40px;"></i>
                    <p class="text-muted">Chưa có sản phẩm nào trong giỏ hàng</p>
                </div>
            }
        </div>

        <div class="cart-summary">
            <div class="summary-row">
                <span>Tạm tính</span>
                <span class="val">@CurrencyHelper.FormatVND(ViewBag.TongTien ?? 0m)</span>
            </div>
            <div class="summary-total">
                <div class="label">TỔNG CỘNG</div>
                <div class="amount">@CurrencyHelper.FormatVND(ViewBag.TongTien ?? 0m)</div>
            </div>
        </div>

        <div class="cart-actions">
            <div class="btn-row">
                <a asp-action="ClearCart" class="btn-pos btn-pos-danger text-decoration-none">
                    <i class="fa-regular fa-trash-can"></i> Hủy bill
                </a>
                <button type="button" class="btn-pos btn-pos-secondary">
                    <i class="fa-regular fa-floppy-disk"></i> Lưu nháp
                </button>
            </div>
            
            <button type="button" class="btn-pos btn-pos-success w-100 mt-2" id="btnOpenPayment"
                    data-cart-count="@(cart?.Count ?? 0)">
                <i class="fa-solid fa-money-bill-wave"></i> THANH TOÁN
            </button>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="pos-toast pos-toast-success show" id="posToastServer">
        <i class="fa-solid fa-circle-check"></i>
        <span>@TempData["Success"]</span>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="pos-toast pos-toast-error show" id="posToastServer">
        <i class="fa-solid fa-circle-xmark"></i>
        <span>@TempData["Error"]</span>
    </div>
}

<div class="pos-toast" id="posToastDynamic">
    <i id="posToastIcon"></i>
    <span id="posToastMsg"></span>
</div>

<div class="modal fade" id="paymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered pay-modal-dialog">
        <div class="modal-content pay-modal-content">

            <div class="pay-modal-header">
                <span class="pay-modal-title">Xác nhận thanh toán</span>
                <button type="button" class="pay-modal-close" data-bs-dismiss="modal">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="pay-receipt-card">
                <div class="pay-receipt-pharmacy">MEDVAULT PHARMACY</div>
                <div class="pay-receipt-info">
                    @DateTime.Now.ToString("dd/MM/yyyy – HH:mm") <br />
                    Thu ngân: @(User.Identity?.IsAuthenticated == true ? User.GetHoTen() : "Chưa xác định")
                </div>
                <div class="pay-receipt-divider"></div>

                <div class="pay-receipt-items">
                    @if (cart != null && cart.Count > 0)
                    {
                        foreach (var item in cart)
                        {
                            <div class="pay-receipt-item">
                                <span>@item.SoLuong x @item.TenSP</span>
                                <span>@CurrencyHelper.FormatVND(item.ThanhTien)</span>
                            </div>
                        }
                    }
                </div>

                <div class="pay-receipt-divider"></div>
                <div class="pay-receipt-total-row">
                    <span>Tổng thanh toán</span>
                    <span class="pay-receipt-total-amount" id="modalTotalAmount" data-amount="@((long)(ViewBag.TongTien ?? 0m))">
                        @CurrencyHelper.FormatVND(ViewBag.TongTien ?? 0m)
                    </span>
                </div>
            </div>

            <div class="pay-section">
                <div class="pay-label">Phương thức thanh toán</div>
                <div class="pay-method-group">
                    <button type="button" class="pay-method-btn active" data-method="TienMat">
                        <i class="fa-regular fa-money-bill-1"></i><span>Tiền mặt</span>
                    </button>
                    <button type="button" class="pay-method-btn" data-method="ChuyenKhoan">
                        <i class="fa-solid fa-building-columns"></i><span>Chuyển khoản</span>
                    </button>
                    <button type="button" class="pay-method-btn" data-method="QuetThe">
                        <i class="fa-solid fa-credit-card"></i><span>Quẹt thẻ</span>
                    </button>
                </div>
            </div>

            <div class="pay-cash-row">
                <span class="pay-label">Khách đưa</span>
                <div class="pay-cash-input-wrap">
                    <input type="number" id="customerCash" class="pay-cash-input" placeholder="0" min="0" />
                    <span class="pay-cash-suffix">đ</span>
                </div>
            </div>

            <div class="pay-change-row">
                <span class="pay-label">Tiền thừa</span>
                <span class="pay-change-amount" id="changeAmount">0đ</span>
            </div>

            <div class="pay-modal-footer">
                <button type="button" class="pay-btn-cancel" data-bs-dismiss="modal">Đóng</button>
                <form asp-action="Checkout" method="post" id="checkoutForm" style="display:inline; margin:0;">
                    <input type="hidden" name="phuongThuc" id="phuongThucInput" value="TienMat" />
                    
                    <button type="button" class="pay-btn-confirm" id="btnConfirmPayment">
                        <i class="fa-solid fa-print"></i> Xuất hóa đơn
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/BanHang.js" asp-append-version="true"></script>
}