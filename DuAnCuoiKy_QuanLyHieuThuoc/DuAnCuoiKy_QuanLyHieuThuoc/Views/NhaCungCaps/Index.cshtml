@using DuAnCuoiKy_QuanLyHieuThuoc.Models.ViewModels
@model SupplierIndexViewModel
@{
    ViewData["Title"] = "Quản lý Nhà cung cấp";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/nhacungcap.css" asp-append-version="true" />
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mx-4 mt-3">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mx-4 mt-3">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="p-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold">Quản lý Nhà cung cấp</h3>
        <button class="btn btn-primary px-4 rounded-3 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalThemNCC">
            <i class="bi bi-plus-lg me-2"></i>Thêm đối tác
        </button>
    </div>

    <!-- Featured Cards -->
    <div class="row g-4 mb-5">
        @foreach (var ncc in Model.FeaturedSuppliers)
        {
            <div class="col-md-4">
                <div class="card border-0 shadow-sm p-4 rounded-4 h-100 card-ncc-featured bg-white btn-xem-ncc"
                     style="cursor:pointer;" data-id="@ncc.MaNcc" title="Xem chi tiết @ncc.TenNcc">
                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <div class="icon-box-fixed bg-primary bg-opacity-10 text-primary">
                            <i class="bi bi-building fs-4"></i>
                        </div>
                        <span class="badge-status-pill bg-primary bg-opacity-10 text-primary">Chiến lược</span>
                    </div>
                    <h5 class="fw-bold mb-1">@ncc.TenNcc</h5>
                    <p class="text-muted small">Mã: @ncc.MaNcc</p>
                    <hr class="my-3 opacity-50">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <div class="dot-status @(ncc.TrangThai ? "bg-success" : "bg-danger")"></div>
                            <span class="small fw-bold">@(ncc.TrangThai ? "Hoạt động" : "Tạm ngưng")</span>
                        </div>
                        <i class="bi bi-arrow-right text-muted"></i>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Danh sách chi tiết -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="p-4 border-bottom d-flex justify-content-between align-items-center bg-white">
            <h5 class="fw-bold mb-0">Danh sách chi tiết</h5>
            <form method="get" class="d-flex gap-2">
                <input type="text" name="search" value="@ViewBag.CurrentSearch"
                       class="form-control border-light bg-light py-2 shadow-none"
                       placeholder="Tìm tên, mã NCC...">
                <button type="submit" class="btn btn-light border"><i class="bi bi-search"></i></button>
            </form>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0 table-hover">
                <thead class="bg-light text-muted small fw-bold">
                    <tr>
                        <th class="ps-4">MÃ NCC</th>
                        <th>TÊN CÔNG TY</th>
                        <th>TỈNH/TP</th>
                        <th>LIÊN HỆ (SĐT)</th>
                        <th>TRẠNG THÁI</th>
                        <th class="text-center">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var n in Model.AllSuppliers)
                    {
                        <tr style="cursor:pointer;">
                            <td class="ps-4 fw-bold text-primary small btn-xem-ncc" data-id="@n.MaNcc">@n.MaNcc</td>
                            <td class="btn-xem-ncc" data-id="@n.MaNcc">
                                <div class="fw-bold">@n.TenNcc</div>
                                <div class="text-muted small" style="font-size:11px;">@n.Email</div>
                            </td>
                            <td class="small btn-xem-ncc" data-id="@n.MaNcc">@(n.MaPhuongXaNavigation?.MaTinhThanhNavigation?.TenTinhThanh ?? "Chưa rõ")</td>
                            <td class="small fw-bold btn-xem-ncc" data-id="@n.MaNcc">@n.SoDienThoai</td>
                            <td class="btn-xem-ncc" data-id="@n.MaNcc">
                                <span class="badge @(n.TrangThai ? "bg-success" : "bg-danger") bg-opacity-10 text-@(n.TrangThai ? "success" : "danger") rounded-pill px-3">
                                    @(n.TrangThai ? "Hoạt động" : "Tạm ngưng")
                                </span>
                            </td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-light rounded-circle me-1 btn-sua-ncc"
                                        data-id="@n.MaNcc" title="Sửa">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form method="post" asp-action="Delete" asp-route-id="@n.MaNcc" class="d-inline"
                                      onsubmit="return confirm('Xác nhận xóa nhà cung cấp \'@n.TenNcc\'?\nHành động này không thể hoàn tác.');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-light rounded-circle text-danger" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.AllSuppliers.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                Không tìm thấy nhà cung cấp nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Thêm mới -->
<partial name="_ModalThemNhaCungCap" />

<!-- Modal Xem chi tiết -->
<div class="modal fade" id="modalXemNCC" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius:20px;">
            <div class="modal-header border-0 p-4 pb-0">
                <h5 class="fw-bold mb-0">Thông tin nhà cung cấp</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center mb-4">
                    <div class="icon-box-fixed bg-primary bg-opacity-10 text-primary mx-auto mb-3" style="width:64px;height:64px;border-radius:16px;display:flex;align-items:center;justify-content:center;">
                        <i class="bi bi-building fs-2"></i>
                    </div>
                    <h5 class="fw-bold mb-0" id="xem_TenNcc"></h5>
                    <span class="text-muted small" id="xem_MaNcc"></span>
                </div>
                <hr class="opacity-25">
                <div class="row g-3 small">
                    <div class="col-6">
                        <div class="text-muted fw-bold mb-1">Số điện thoại</div>
                        <div id="xem_SoDienThoai" class="fw-bold"></div>
                    </div>
                    <div class="col-6">
                        <div class="text-muted fw-bold mb-1">Trạng thái</div>
                        <div id="xem_TrangThai"></div>
                    </div>
                    <div class="col-12">
                        <div class="text-muted fw-bold mb-1">Email</div>
                        <div id="xem_Email"></div>
                    </div>
                    <div class="col-12">
                        <div class="text-muted fw-bold mb-1">Tỉnh / Thành phố</div>
                        <div id="xem_TinhThanh"></div>
                    </div>
                    <div class="col-12">
                        <div class="text-muted fw-bold mb-1">Địa chỉ chi tiết</div>
                        <div id="xem_DiaChi"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 p-4 pt-0">
                <button type="button" class="btn btn-light px-4 rounded-3 fw-bold" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary px-4 rounded-3 fw-bold" id="btnChuyenSangSua">
                    <i class="bi bi-pencil me-1"></i>Chỉnh sửa
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Sửa -->
<div class="modal fade" id="modalSuaNCC" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius:20px;">
            <div class="modal-header border-0 p-4 pb-0">
                <h5 class="fw-bold mb-0">Chỉnh sửa nhà cung cấp</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Edit" method="post" id="formSuaNCC">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <input type="hidden" name="MaNcc" id="edit_MaNcc">

                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">Tên nhà cung cấp <span class="text-danger">*</span></label>
                            <input name="TenNcc" id="edit_TenNcc"
                                   class="form-control bg-light border-0 py-2 shadow-none"
                                   placeholder="Tên nhà cung cấp">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Số điện thoại <span class="text-danger">*</span></label>
                            <input name="SoDienThoai" id="edit_SoDienThoai"
                                   class="form-control bg-light border-0 py-2 shadow-none"
                                   placeholder="09xx xxx xxx">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Email</label>
                            <input name="Email" id="edit_Email" type="email"
                                   class="form-control bg-light border-0 py-2 shadow-none"
                                   placeholder="email@domain.com">
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">Địa chỉ chi tiết</label>
                            <textarea name="DiaChiChiTiet" id="edit_DiaChi"
                                      class="form-control bg-light border-0 shadow-none" rows="2"
                                      placeholder="Số nhà, tên đường, phường/xã..."></textarea>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input name="TrangThai" id="edit_TrangThai" type="checkbox"
                                       class="form-check-input" value="true">
                                <input name="TrangThai" type="hidden" value="false">
                                <label class="form-check-label small fw-bold">Đang hoạt động</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-light px-4 rounded-3 fw-bold" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-primary px-4 rounded-3 fw-bold shadow-sm">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/nhacungcap.js" asp-append-version="true"></script>
}
