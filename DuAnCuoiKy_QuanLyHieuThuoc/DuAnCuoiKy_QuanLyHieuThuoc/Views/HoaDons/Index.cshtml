@model IEnumerable<DuAnCuoiKy_QuanLyHieuThuoc.Models.HoaDon>

@{
    ViewData["Title"] = "Lịch sử hóa đơn";
}

@section Styles {
    <!-- Gắn file CSS để tạo kiểu giống ảnh thiết kế -->
    <link rel="stylesheet" href="~/css/_LichSuHoaDon.css" asp-append-version="true" />
}

<div class="history-container">
    
    <!-- 1. BREADCRUMB & TIÊU ĐỀ -->
    <div class="history-breadcrumb">
        <a href="#">Bán hàng</a>
        <span class="sep">›</span>
        <span>Lịch sử hóa đơn</span>
    </div>
    <h2 class="history-title">Lịch sử hóa đơn</h2>

    <!-- 2. THANH LỌC (TOOLBAR) -->
    <div class="history-toolbar">
        <form method="get" class="toolbar-form" id="filterForm">
        
            <div class="search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" name="searchKeyword" value="@ViewBag.SearchKeyword" placeholder="Tìm mã HĐ, tên thuốc..." />
            </div>

            <div class="filter-dropdown">
                <i class="fa-regular fa-calendar"></i>
                <select name="timeFilter" onchange="this.form.submit()">
                    <option value="all" selected="@(ViewBag.TimeFilter == "all" ? "selected" : null)">Tất cả thời gian</option>
                    <option value="today" selected="@(ViewBag.TimeFilter == "today" ? "selected" : null)">Hôm nay</option>
                    <option value="yesterday" selected="@(ViewBag.TimeFilter == "yesterday" ? "selected" : null)">Hôm qua</option>
                    <option value="7days" selected="@(ViewBag.TimeFilter == "7days" ? "selected" : null)">7 ngày qua</option>
                </select>
            </div>

            <div class="filter-dropdown">
                <select name="statusFilter" onchange="this.form.submit()">
                    <option value="" selected="@(string.IsNullOrEmpty(ViewBag.StatusFilter) ? "selected" : null)">Trạng thái</option>
                    <option value="success" selected="@(ViewBag.StatusFilter == "success" ? "selected" : null)">Hoàn thành</option>
                    <option value="cancelled" selected="@(ViewBag.StatusFilter == "cancelled" ? "selected" : null)">Đã hủy</option>
                </select>
            </div>

        </form>
    </div>

    <!-- 3. BẢNG DỮ LIỆU -->
    <div class="history-table-wrapper">
        <table class="table history-table">
            <thead>
                <tr>
                    <th>Mã HĐ</th>
                    <th>Thời gian</th>
                    <th>Danh sách thuốc</th>
                    <th>Tổng tiền</th>
                    <th>TT Thanh toán</th>
                    <th>Trạng thái</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <!-- Mã HĐ -->
                            <td class="fw-bold text-dark">@item.MaHd</td>
                            
                            <!-- Thời gian -->
                            <td>@item.NgayBan.ToString("HH:mm dd/MM/yyyy")</td>
                            
                            <!-- Danh sách thuốc (Bóc tách dữ liệu thật) -->
                            <td class="text-muted text-truncate" style="max-width: 280px;">
                                @{
                                    var danhSachThuoc = item.ChiTietHoaDons != null
                                        ? item.ChiTietHoaDons
                                            .Where(ct => ct.SoLoNavigation?.MaSpNavigation != null)
                                            .Select(ct => ct.SoLoNavigation.MaSpNavigation.TenSp)
                                            .Distinct()
                                            .ToList()
                                        : new List<string>();
                                        
                                    string chuoiThuoc = string.Join(", ", danhSachThuoc);
                                }
                                
                                @if (danhSachThuoc.Any())
                                {
                                    <span title="@chuoiThuoc">@chuoiThuoc</span>
                                }
                                else
                                {
                                    <span class="text-warning">Chưa có thông tin thuốc</span>
                                }
                            </td>
                            
                            <!-- Tổng tiền -->
                            <td class="fw-semibold text-dark">@((item.TongTien ?? 0).ToString("N0")) đ</td>
                            
                            <!-- Thanh toán (Hiện fix cứng Tiền mặt, có thể mở rộng sau) -->
                            <td><span class="text-secondary">Tiền mặt</span></td>
                            
                            <!-- Trạng thái -->
                            <td>
                                @if (item.GhiChu != null && item.GhiChu.ToLower().Contains("hủy"))
                                {
                                    <span class="badge-status badge-cancelled">Đã hủy</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-completed">Hoàn thành</span>
                                }
                            </td>
                            
                            <!-- Nút con mắt -->
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@item.MaHd" class="btn-view-detail" title="Xem chi tiết">
                                    <i class="fa-regular fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">Không tìm thấy lịch sử hóa đơn nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- 4. PHÂN TRANG -->
    <div class="history-footer">
        @{
            int currentPage = ViewBag.CurrentPage;
            int totalPages = ViewBag.TotalPages;
            int totalCount = ViewBag.TotalCount;
            int pageSize = ViewBag.PageSize;

            int startItem = totalCount == 0 ? 0 : (currentPage - 1) * pageSize + 1;
            int endItem = Math.Min(currentPage * pageSize, totalCount);
        }

        <div class="results-count">
            Hiển thị @startItem đến @endItem trong số @totalCount kết quả
        </div>

        <div class="pagination-buttons">
            @if (currentPage > 1)
            {
                <a href="@Url.Action("Index", new { searchKeyword = ViewBag.SearchKeyword, timeFilter = ViewBag.TimeFilter, statusFilter = ViewBag.StatusFilter, page = currentPage - 1 })" class="pag-btn" style="text-decoration: none;">
                    <i class="fa-solid fa-chevron-left"></i>
                </a>
            }
            else
            {
                <button class="pag-btn" disabled><i class="fa-solid fa-chevron-left"></i></button>
            }

            @for (int i = 1; i <= totalPages; i++)
            {
                if (i == currentPage)
                {
                    <button class="pag-btn active">@i</button>
                }
                else
                {
                    <a href="@Url.Action("Index", new { searchKeyword = ViewBag.SearchKeyword, timeFilter = ViewBag.TimeFilter, statusFilter = ViewBag.StatusFilter, page = i })" class="pag-btn" style="text-decoration: none;">@i</a>
                }
            }

            @if (currentPage < totalPages)
            {
                <a href="@Url.Action("Index", new { searchKeyword = ViewBag.SearchKeyword, timeFilter = ViewBag.TimeFilter, statusFilter = ViewBag.StatusFilter, page = currentPage + 1 })" class="pag-btn" style="text-decoration: none;">
                    <i class="fa-solid fa-chevron-right"></i>
                </a>
            }
            else
            {
                <button class="pag-btn" disabled><i class="fa-solid fa-chevron-right"></i></button>
            }
        </div>
    </div>