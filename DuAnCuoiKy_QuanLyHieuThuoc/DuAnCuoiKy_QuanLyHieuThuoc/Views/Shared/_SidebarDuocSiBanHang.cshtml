@{
    // Lấy tên Controller hiện tại để tự động tô màu xanh (active) cho menu tương ứng
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<div class="sidebar-wrapper d-flex flex-column justify-content-between bg-white border-end p-3">
    <div>
        <div class="d-flex align-items-center gap-3 p-3 mb-4 rounded-3 sidebar-user-card">
            <img src="https://img.freepik.com/free-photo/handsome-smiling-medical-professional-examining-with-stethoscope_1150-10335.jpg?w=150"
                 alt="Staff Avatar" width="45" height="45" class="rounded-circle border border-2 border-primary border-opacity-10 shadow-sm" style="object-fit: cover;">
            <div class="overflow-hidden">
                <h6 class="fw-bold text-dark mb-0 text-truncate fs-6">Trần Văn Hùng</h6>
                <small class="text-muted d-block text-truncate" style="font-size: 0.75rem;">Nhân viên bán hàng</small>
            </div>
        </div>

        <ul class="nav flex-column gap-2">
            <li class="nav-item">
                <a href="@Url.Action("Index", "TongQuanCaLam")"
                    class="nav-link sidebar-link @(currentController == "TongQuanCaLam" || currentController == null ? "active" : "")">
                    <i class="bi bi-clock-history fs-5"></i>
                    <span>Tổng quan ca làm</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="@Url.Action("Index", "BanHangs")"
                    class="nav-link sidebar-link @(currentController == "BanHangs" ? "active" : "")">
                    <i class="bi bi-pc-display-horizontal fs-5"></i>
                    <span>Bán hàng (POS)</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="@Url.Action("Index", "HoaDons")" 
                class="nav-link sidebar-link @(currentController == "HoaDons" ? "active" : "")">
                    <i class="bi bi-receipt fs-5"></i>
                    <span>Lịch sử hóa đơn</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="@Url.Action("Index", "KhoHangs")" 
                class="nav-link sidebar-link @(currentController == "KhoHangs" ? "active" : "")">
                    <i class="bi bi-box-seam fs-5"></i>
                    <span>Xem tồn kho</span>
                </a>
            </li>
        </ul>
    </div>

    <div>
        <a href="#" class="nav-link sidebar-link sidebar-logout text-danger">
            <i class="bi bi-box-arrow-left fs-5"></i>
            <span>Đăng xuất</span>
        </a>
    </div>
</div>