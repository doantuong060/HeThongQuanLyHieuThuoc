@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}

<div class="sidebar-kho-wrapper d-flex flex-column justify-content-between bg-white border-end">

    <!-- Logo -->
    <div>
        <div class="sidebar-kho-logo d-flex align-items-center gap-2 border-bottom">
            <span class="fs-4">💊</span>
            <span class="fw-bold fs-5 text-dark">MedVault</span>
        </div>

        <!-- User card -->
        <div class="sidebar-kho-user mx-3 mt-3 mb-2 p-3 rounded-3">
            <div class="d-flex align-items-center gap-2">
                <img src="https://i.pravatar.cc/80?img=12"
                     alt="Avatar" width="40" height="40"
                     class="rounded-circle flex-shrink-0" style="object-fit:cover;">
                <div class="overflow-hidden">
                    <div class="fw-semibold text-dark text-truncate" style="font-size:13px;">Phạm Văn Bình</div>
                    <div class="text-muted text-truncate" style="font-size:11px;">Nhân viên kho</div>
                </div>
            </div>
        </div>

        <!-- Nav -->
        <ul class="nav flex-column gap-1 px-2 mt-1">
            <li class="nav-item">
                <a asp-controller="Home" asp-action="Index"
                   class="sidebar-kho-link nav-link @(ctrl == "Home" && action == "Index" ? "active" : "")">
                    <i class="bi bi-house-door"></i>
                    <span>Tổng quan kho</span>
                </a>
            </li>
            <li class="nav-item">
                <a asp-controller="PhieuNhaps" asp-action="Create"
                   class="sidebar-kho-link nav-link @(ctrl == "PhieuNhaps" && action == "Create" ? "active" : "")">
                    <i class="bi bi-box-arrow-in-down"></i>
                    <span>Nhập hàng</span>
                </a>
            </li>
            <li class="nav-item">
                <a asp-controller="PhieuNhaps" asp-action="Index"
                   class="sidebar-kho-link nav-link @(ctrl == "PhieuNhaps" && action == "Index" ? "active" : "")">
                    <i class="bi bi-list-ul"></i>
                    <span>Danh sách phiếu</span>
                </a>
            </li>
            <li class="nav-item">
                <a asp-controller="LoHangs" asp-action="Index"
                   class="sidebar-kho-link nav-link @(ctrl == "LoHangs" ? "active" : "")">
                    <i class="bi bi-exclamation-triangle"></i>
                    <span>Tồn kho &amp; Cảnh báo</span>
                </a>
            </li>
        </ul>
    </div>

    <!-- Đăng xuất -->
    <div class="px-2 pb-3 border-top pt-3 mx-1">
        <a asp-controller="Account" asp-action="Logout"
           class="sidebar-kho-link nav-link text-danger">
            <i class="bi bi-box-arrow-left"></i>
            <span>Đăng xuất</span>
        </a>
    </div>
</div>
