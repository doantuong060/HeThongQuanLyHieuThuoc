@{
    ViewData["Title"] = "Dashboard - Tổng quan";
    Layout = "_Layout";
}

<div class="p-4">
    <div class="mb-4">
        <h3 class="fw-bold text-dark">Chào mừng trở lại, Nguyễn Thị Mai!</h3>
        <p class="text-muted">Hệ thống đang hoạt động ổn định. Kiểm tra báo cáo hôm nay của bạn.</p>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        @foreach (var stat in new[] {
            new { Label = "Doanh thu hôm nay", Val = ViewBag.DoanhThuHomNay + "đ", Trend = "+12.5%", Icon = "cash-stack", Color = "primary" },
            new { Label = "Số hóa đơn", Val = ViewBag.SoHoaDon.ToString(), Trend = "+8 đơn mới", Icon = "receipt", Color = "secondary" }
        })
        {
            <div class="col-md-3">
                <div class="card border-0 shadow-sm p-3 rounded-4">
                    <div class="d-flex justify-content-between text-muted small fw-bold">@stat.Label <i class="bi bi-@stat.Icon fs-4 text-@stat.Color"></i></div>
                    <div class="h3 fw-bold my-2">@stat.Val</div>
                    <div class="text-success small fw-bold">@stat.Trend</div>
                </div>
            </div>
        }
        <!-- Thuốc sắp hết -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 rounded-4">
                <div class="d-flex justify-content-between text-muted small fw-bold">Thuốc sắp hết <i class="bi bi-exclamation-triangle fs-4 text-warning"></i></div>
                <div class="h3 fw-bold my-2 text-warning">@ViewBag.ThuocSapHet</div>
                <div class="text-danger small fw-bold">Cần nhập kho ngay</div>
            </div>
        </div>
        <!-- Lô sắp hết hạn -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 rounded-4">
                <div class="d-flex justify-content-between text-muted small fw-bold">Lô sắp hết hạn <i class="bi bi-calendar-x fs-4 text-danger"></i></div>
                <div class="h3 fw-bold my-2 text-danger">@ViewBag.LoSapHetHan</div>
                <div class="text-muted small">Trong 30 ngày tới</div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm p-4 rounded-4 h-100">
                <h5 class="fw-bold mb-4">Doanh thu 6 tháng</h5>
                <!-- FIX: Chiều cao cố định và position relative cho Chart -->
                <div style="position: relative; height: 320px; width: 100%;">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 rounded-4 h-100">
                <h5 class="fw-bold mb-4">Cảnh báo tồn kho</h5>
                <div class="list-group list-group-flush">
                    @foreach (var item in ViewBag.CanhBaoTonKho)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center border-0 px-0 py-3 border-bottom">
                            <div class="fw-bold small">@item.Ten <br><span class="text-@item.Mau fw-normal">Tồn: @item.Ton</span></div>
                            <button class="btn btn-sm btn-outline-primary rounded-pill px-3">Nhập</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('revenueChart').getContext('2d');
        new Chart(ctx, {
        type: 'bar',
        data: {
        labels: ['T1', 'T2', 'T3', 'T4', 'T5', 'T6'],
        datasets: [{
        label: 'Doanh thu',
        data: [45, 60, 52, 85, 78, 88],
        backgroundColor: '#0d6efd',
        borderRadius: 10,
        barThickness: 40
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
        y: { beginAtZero: true, grid: { display: false } },
        x: { grid: { display: false } }
        }
        }
        });
    </script>
}