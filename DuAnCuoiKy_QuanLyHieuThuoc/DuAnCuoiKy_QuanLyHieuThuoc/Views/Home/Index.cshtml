@{
    ViewData["Title"] = "Tổng quan kho";
    Layout = "~/Views/Shared/_LayoutNhanVienKho.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/KhoTongQuan.css" asp-append-version="true" />
}

<!-- Breadcrumb -->
<div class="kho-breadcrumb">
    <i class="bi bi-grid-1x2" style="font-size:12px;"></i>
    <span>Quản lý kho</span>
    <i class="bi bi-chevron-right" style="font-size:10px;"></i>
    <span class="current">Tổng quan</span>
</div>

<div class="kho-page-title">
    Tổng quan kho
</div>

<!-- Stat cards -->
<div class="kho-stat-row">

    <div class="kho-stat-card">

        <span class="stat-badge blue">
            Tất cả
        </span>

        <span class="stat-icon">
            <i class="bi bi-box-seam stat-blue"></i>
        </span>

        <div class="stat-label">
            Tổng mặt hàng
        </div>

        <div class="stat-value">
            248
        </div>

        <div class="stat-unit">
            loại
        </div>

    </div>

    <div class="kho-stat-card">

        <span class="stat-badge orange">
            Cảnh báo
        </span>

        <span class="stat-icon">
            <i class="bi bi-arrow-down-circle stat-orange"></i>
        </span>

        <div class="stat-label">
            Sắp hết hàng
        </div>

        <div class="stat-value stat-orange">
            24
        </div>

        <div class="stat-unit">
            mặt hàng
        </div>

    </div>

    <div class="kho-stat-card">

        <span class="stat-badge red">
            Nguy cấp
        </span>

        <span class="stat-icon">
            <i class="bi bi-calendar-x stat-red"></i>
        </span>

        <div class="stat-label">
            Hết hạn ≤30 ngày
        </div>

        <div class="stat-value stat-red">
            08
        </div>

        <div class="stat-unit">
            lô
        </div>

    </div>

</div>

<!-- ROW 2 -->
<div class="kho-two-col">

    <!-- THUỐC CẦN NHẬP -->
    <div class="kho-panel">

        <div class="panel-header">

            <i class="bi bi-cart-plus panel-red"></i>

            <span class="kho-panel-title">
                Thuốc cần nhập ngay
            </span>

        </div>

        <table class="kho-inner-table">

            <thead>

                <tr>
                    <th>Tên thuốc</th>
                    <th>Tồn kho</th>
                    <th>Định mức</th>
                    <th>Hành động</th>
                </tr>

            </thead>

            <tbody>

                <tr>

                    <td class="fw-semibold">
                        Amoxicillin 500mg
                    </td>

                    <td>
                        <span class="txt-red fw-semibold">
                            15 hộp
                        </span>
                    </td>

                    <td class="txt-muted">
                        50 hộp
                    </td>

                    <td>

                        <a asp-controller="PhieuNhaps"
                           asp-action="Create"
                           class="kho-btn-primary btn-sm-kho">

                            Tạo phiếu

                        </a>

                    </td>

                </tr>

                <tr>

                    <td class="fw-semibold">
                        Paracetamol 500mg
                    </td>

                    <td>
                        <span class="txt-orange fw-semibold">
                            20 vỉ
                        </span>
                    </td>

                    <td class="txt-muted">
                        100 vỉ
                    </td>

                    <td>

                        <a asp-controller="PhieuNhaps"
                           asp-action="Create"
                           class="kho-btn-primary btn-sm-kho">

                            Tạo phiếu

                        </a>

                    </td>

                </tr>

                <tr>

                    <td class="fw-semibold">
                        Vitamin C 1000mg
                    </td>

                    <td>
                        <span class="txt-orange fw-semibold">
                            5 lọ
                        </span>
                    </td>

                    <td class="txt-muted">
                        30 lọ
                    </td>

                    <td>

                        <a asp-controller="PhieuNhaps"
                           asp-action="Create"
                           class="kho-btn-primary btn-sm-kho">

                            Tạo phiếu

                        </a>

                    </td>

                </tr>

            </tbody>

        </table>

    </div>

    <!-- HẾT HẠN -->
    <div class="kho-panel">

        <div class="panel-header">

            <i class="bi bi-calendar-event panel-blue"></i>

            <span class="kho-panel-title">
                Lô hàng sắp hết hạn
            </span>

        </div>

        <table class="kho-inner-table">

            <thead>

                <tr>
                    <th>Tên thuốc</th>
                    <th>Số lô</th>
                    <th>Hạn sử dụng</th>
                    <th>Trạng thái</th>
                </tr>

            </thead>

            <tbody>

                <tr>

                    <td class="fw-semibold">
                        Oresol 245
                    </td>

                    <td class="lot-code">
                        LOT-2301A
                    </td>

                    <td class="small-date">
                        15/11/2023
                    </td>

                    <td>
                        <span class="status-badge red">
                            Hết hạn
                        </span>
                    </td>

                </tr>

                <tr>

                    <td class="fw-semibold">
                        Berberin 100mg
                    </td>

                    <td class="lot-code">
                        LOT-2210C
                    </td>

                    <td class="small-date">
                        02/12/2023
                    </td>

                    <td>
                        <span class="status-badge orange">
                            Sắp hết hạn
                        </span>
                    </td>

                </tr>

                <tr>

                    <td class="fw-semibold">
                        Nước muối sinh lý
                    </td>

                    <td class="lot-code">
                        LOT-2305B
                    </td>

                    <td class="small-date">
                        10/12/2023
                    </td>

                    <td>
                        <span class="status-badge orange">
                            Sắp hết hạn
                        </span>
                    </td>

                </tr>

            </tbody>

        </table>

    </div>

</div>

<!-- PHIẾU GẦN ĐÂY -->
<div class="kho-panel">

    <div class="recent-header">

        <div class="panel-header">

            <i class="bi bi-receipt panel-blue"></i>

            <span class="kho-panel-title">
                Phiếu nhập kho gần đây
            </span>

        </div>

        <a asp-controller="PhieuNhaps"
           asp-action="Index"
           class="recent-link">

            Xem tất cả →

        </a>

    </div>

    <table class="kho-inner-table">

        <thead>

            <tr>
                <th>Mã phiếu</th>
                <th>Ngày nhập</th>
                <th>Nhà cung cấp</th>
                <th class="text-end">Tổng tiền</th>
            </tr>

        </thead>

        <tbody>

            <tr>

                <td>
                    <a href="#" class="pn-code-link">
                        PN-20231024-01
                    </a>
                </td>

                <td class="small-date">
                    24/10/2023 09:30
                </td>

                <td>
                    Công ty Dược phẩm Trung ương 1
                </td>

                <td class="money-cell">
                    15,450,000 đ
                </td>

            </tr>

            <tr>

                <td>
                    <a href="#" class="pn-code-link">
                        PN-20231023-02
                    </a>
                </td>

                <td class="small-date">
                    23/10/2023 14:15
                </td>

                <td>
                    Công ty TNHH Dược phẩm Hậu Giang
                </td>

                <td class="money-cell">
                    8,200,000 đ
                </td>

            </tr>

            <tr>

                <td>
                    <a href="#" class="pn-code-link">
                        PN-20231021-01
                    </a>
                </td>

                <td class="small-date">
                    21/10/2023 10:00
                </td>

                <td>
                    Công ty CP Traphaco
                </td>

                <td class="money-cell">
                    24,100,000 đ
                </td>

            </tr>

        </tbody>

    </table>

</div>