@model DuAnCuoiKy_QuanLyHieuThuoc.Models.TaiKhoan
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - MedVault</title>

    <!-- CSS hệ thống -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <!-- CSS đã tách -->
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <div class="login-card">
        <div class="brand-logo">MedVault 💊</div>

        <h4 class="fw-bold text-dark text-center mb-1">Chào mừng trở lại</h4>
        <p class="text-muted text-center small mb-4">Đăng nhập để quản lý hệ thống hiệu thuốc của bạn</p>

        <form asp-action="Login" asp-controller="Home" method="post">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2 small">@ViewBag.Error</div>
            }

            <div class="mb-3">
                <label class="form-label small fw-bold">Tên đăng nhập</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0 text-muted"><i class="bi bi-person"></i></span>
                    <input type="text" name="TenDangNhap" class="form-control border-start-0 shadow-none" placeholder="Nhập tên đăng nhập" required>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-bold">Mật khẩu</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                    <input type="password" name="MatKhau" id="passwordField" class="form-control border-start-0 shadow-none" placeholder="Nhập mật khẩu" required>
                    <!-- Nút con mắt để chạy JS đã tách -->
                    <span class="input-group-text bg-transparent border-start-0 password-toggle text-muted">
                        <i class="bi bi-eye-slash"></i>
                    </span>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input shadow-none" id="rememberMe">
                    <label class="form-check-label small text-muted" for="rememberMe">Ghi nhớ đăng nhập</label>
                </div>
                <a href="#" class="text-primary small text-decoration-none fw-bold">Quên mật khẩu?</a>
            </div>

            <button type="submit" class="btn btn-primary w-100 btn-login">Đăng nhập <i class="bi bi-arrow-right ms-2"></i></button>
        </form>

        <div class="mt-5 pt-3 border-top text-center">
            <small class="text-muted"><i class="bi bi-headset me-2"></i>Hỗ trợ kỹ thuật: 1900 xxxx</small>
        </div>
    </div>

    <!-- JS hệ thống -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- JS đã tách -->
    <script src="~/js/login.js" asp-append-version="true"></script>
</body>
</html>