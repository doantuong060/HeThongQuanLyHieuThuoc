@model DuAnCuoiKy_QuanLyHieuThuoc.Models.ViewModels.LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Đăng nhập - MedVault</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <div class="login-card">
        <div class="brand-logo">MedVault 💊</div>
        <h4 class="fw-bold text-dark text-center mb-1">Chào mừng trở lại</h4>
        <p class="text-muted text-center small mb-4">Hệ thống Quản lý Hiệu thuốc</p>

        <form asp-action="Login" method="post">
            <!-- Hiển thị thông báo lỗi từ Controller (Sai pass, bị khóa...) -->
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 p-2 bg-danger bg-opacity-10 rounded"></div>

            <div class="mb-3">
                <label class="form-label small fw-bold">Tên đăng nhập</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-0"><i class="bi bi-person"></i></span>
                    <input asp-for="TenDangNhap" class="form-control bg-light border-0" placeholder="Nhập tên đăng nhập">
                </div>
                <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-bold">Mật khẩu</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-0"><i class="bi bi-lock"></i></span>
                    <input asp-for="MatKhau" type="password" id="passwordField" class="form-control bg-light border-0" placeholder="Nhập mật khẩu">
                    <span class="input-group-text bg-light border-0 password-toggle" style="cursor:pointer">
                        <i class="bi bi-eye-slash"></i>
                    </span>
                </div>
                <span asp-validation-for="MatKhau" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <input asp-for="GhiNho" class="form-check-input">
                    <label class="form-check-label small text-muted">Ghi nhớ</label>
                </div>
                <a href="#" class="text-primary small text-decoration-none fw-bold">Quên mật khẩu?</a>
            </div>

            <button type="submit" class="btn btn-primary w-100 btn-login shadow-sm">Đăng nhập</button>
        </form>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/login.js" asp-append-version="true"></script>
</body>
</html>