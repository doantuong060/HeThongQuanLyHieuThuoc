@model List<DuAnCuoiKy_QuanLyHieuThuoc.Models.SanPhamKho>

@{
    ViewData["Title"] = "Xem tồn kho";

    int page = (int)ViewBag.Page;
    int totalPages = (int)ViewBag.TotalPages;
    int totalItems = (int)ViewBag.TotalItems;
    int pageSize = (int)ViewBag.PageSize;
    string keyword = ViewBag.Keyword ?? "";
    string selLoai = ViewBag.SelectedLoai ?? "";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();

    int fromItem = (page - 1) * pageSize + 1;
    int toItem = Math.Min(page * pageSize, totalItems);

    // Helper: CSS cho badge tồn kho
    string StockClass(string tt) => tt switch
    {
        "San sang" => "kh-stock-ok",
        "Binh thuong" => "kh-stock-normal",
        "Sap het" => "kh-stock-low",
        "Het hang" => "kh-stock-empty",
        _ => "kh-stock-normal"
    };

    // Helper: CSS cho badge trạng thái
    string StatusClass(string tt) => tt switch
    {
        "San sang" => "kh-status-san-sang",
        "Binh thuong" => "kh-status-binh-thuong",
        "Sap het" => "kh-status-sap-het",
        "Het hang" => "kh-status-het-hang",
        _ => "kh-status-binh-thuong"
    };

    // Helper: nhãn tiếng Việt
    string StatusLabel(string tt) => tt switch
    {
        "San sang" => "Sẵn sàng",
        "Binh thuong" => "Bình thường",
        "Sap het" => "Sắp hết",
        "Het hang" => "Hết hàng",
        _ => tt
    };

    // Helper: tên thuốc đỏ khi sắp hết / hết hàng
    string NameClass(string tt) =>
        (tt == "Sap het" || tt == "Het hang") ? "kh-name-warning" : "kh-name-normal";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_KhoHang.css" asp-append-version="true" />
}

<div class="kh-page">

    <!-- ── BREADCRUMB ── -->
    <nav class="kh-breadcrumb">
        <a asp-controller="BanHangs" asp-action="Index">Bán hàng</a>
        <span class="sep">›</span>
        <span class="current">Tồn kho</span>
    </nav>

    <!-- ── HEADER ── -->
    <div class="kh-header">
        <h1 class="kh-title">Tồn kho</h1>

        <div class="kh-header-right">
            <!-- TÌM KIẾM -->
            <form method="get" id="searchForm" style="display:contents;">
                <input type="hidden" name="loai" value="@selLoai" />
                <input type="hidden" name="page" value="1" />
                <div class="kh-search-wrap">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text"
                           name="keyword"
                           id="searchInput"
                           class="kh-search-input"
                           value="@keyword"
                           placeholder="Tìm thuốc..." />
                </div>
            </form>

            <!-- LỌC LOẠI -->
            <div style="position:relative;">
                <button class="kh-btn-filter @(!string.IsNullOrEmpty(selLoai) ? "active" : "")"
                        id="btnFilter" type="button">
                    <i class="fa-solid fa-sliders"></i>
                    Lọc loại
                    @if (!string.IsNullOrEmpty(selLoai))
                    {
                        <span style="font-size:11px;background:#2563eb;color:#fff;border-radius:99px;padding:1px 7px;margin-left:2px;">1</span>
                    }
                    <i class="fa-solid fa-chevron-down" style="font-size:11px;margin-left:2px;"></i>
                </button>

                <div class="kh-filter-dropdown" id="filterDropdown">
                    <a href="@Url.Action("Index", new { keyword, loai = "", page = 1 })"
                           class="kh-filter-item @(string.IsNullOrEmpty(selLoai) ? "active" : "")">
                        Tất cả loại
                    </a>
                    @foreach (var cat in categories)
                    {
                        <a href="@Url.Action("Index", new { keyword, loai = cat, page = 1 })"
                               class="kh-filter-item @(selLoai == cat ? "active" : "")">
                            @cat
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ── BẢNG TỒN KHO ── -->
    <div class="kh-card">
        <table class="kh-table">
            <thead>
                <tr>
                    <th>Tên thuốc</th>
                    <th>Loại</th>
                    <th>ĐVT</th>
                    <th class="center">Tồn kho</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="5" style="text-align:center;padding:40px;color:#9ca3af;">
                            <i class="fa-solid fa-box-open" style="font-size:28px;margin-bottom:8px;display:block;"></i>
                            Không tìm thấy sản phẩm nào
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var sp in Model)
                    {
                        <tr>
                            <td><span class="@NameClass(sp.TrangThai)">@sp.TenThuoc</span></td>
                            <td><span class="kh-loai">@sp.Loai</span></td>
                            <td><span class="kh-dvt">@sp.DonViTinh</span></td>
                            <td class="center">
                                <span class="kh-stock-badge @StockClass(sp.TrangThai)">
                                    @sp.TonKho.ToString("N0")
                                </span>
                            </td>
                            <td>
                                <span class="kh-status @StatusClass(sp.TrangThai)">
                                    <span class="kh-status-dot"></span>
                                    @StatusLabel(sp.TrangThai)
                                </span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <!-- ── FOOTER PHÂN TRANG ── -->
        <div class="kh-footer">
            <span class="kh-footer-info">
                Hiển thị @fromItem–@toItem của @totalItems sản phẩm
            </span>
            <div class="kh-pagination">
                @if (page <= 1)
                {
                    <span class="kh-page-btn disabled"><i class="fa-solid fa-chevron-left"></i></span>
                }
                else
                {
                    <a class="kh-page-btn"
                           href="@Url.Action("Index", new { keyword, loai = selLoai, page = page - 1 })">
                        <i class="fa-solid fa-chevron-left"></i>
                    </a>
                }

                @if (page >= totalPages)
                {
                    <span class="kh-page-btn disabled"><i class="fa-solid fa-chevron-right"></i></span>
                }
                else
                {
                    <a class="kh-page-btn"
                           href="@Url.Action("Index", new { keyword, loai = selLoai, page = page + 1 })">
                        <i class="fa-solid fa-chevron-right"></i>
                    </a>
                }
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/KhoHang.js" asp-append-version="true"></script>
}
