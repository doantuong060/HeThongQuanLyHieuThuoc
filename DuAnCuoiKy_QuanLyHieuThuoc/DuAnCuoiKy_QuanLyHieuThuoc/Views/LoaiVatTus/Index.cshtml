@model IEnumerable<DuAnCuoiKy_QuanLyHieuThuoc.Models.LoaiVatTu>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TenLoaiVt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MoTa)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.TenLoaiVt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MoTa)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.MaLoaiVt">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.MaLoaiVt">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.MaLoaiVt">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
